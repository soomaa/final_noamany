      "name": "Calorie calculator",
      "item": [
        {
          "name": "Calculate daily calories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('calorie calculation returns the expected form values', () => pm.expect(body.data).to.include({ bmr: Number(pm.variables.replaceIn('{{expectedBmr}}')), maintenanceCalories: Number(pm.variables.replaceIn('{{expectedMaintenanceCalories}}')), targetCalories: Number(pm.variables.replaceIn('{{expectedTargetCalories}}')), goal: pm.variables.replaceIn('{{calorieGoal}}') }));",
                  "pm.test('calorie calculation splits the target into macros', () => { const macros = body.data.macros; pm.expect(macros).to.have.keys('protein', 'fat', 'carbohydrates'); ['protein', 'fat', 'carbohydrates'].forEach((key) => pm.expect(macros[key]).to.include.keys('grams', 'calories', 'percent')); const total = macros.protein.calories + macros.fat.calories + macros.carbohydrates.calories; pm.expect(total).to.eql(body.data.targetCalories); });",
                  "pm.test('calorie calculation includes an estimate disclaimer', () => pm.expect(body.data.note).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gender\": \"{{calorieGender}}\",\n  \"age\": {{calorieAge}},\n  \"height_cm\": {{calorieHeightCm}},\n  \"current_weight_kg\": {{calorieCurrentWeightKg}},\n  \"target_weight_kg\": {{calorieTargetWeightKg}},\n  \"activity_level\": \"{{calorieActivityLevel}}\",\n  \"goal\": \"{{calorieGoal}}\"\n}"
