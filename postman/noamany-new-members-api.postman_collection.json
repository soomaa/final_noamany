  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test('HTTP response is successful', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
          "const isLegacyMemberRequest = pm.request.url.toString().includes('/Api/members/');",
          "if (isLegacyMemberRequest) { const body = pm.response.json(); pm.test('legacy response envelope is present', () => pm.expect(body).to.have.property('status')); pm.test('legacy status is numeric', () => pm.expect(body.status).to.be.a('number')); const dataDependentRequests = new Set(['Trainer details', 'Offer details', 'Basic package details', 'Private package details', 'Validate coupon']); pm.test('application result matches the local test-data expectation', () => pm.expect(body.status).to.be.oneOf(dataDependentRequests.has(pm.info.requestName) ? [200, 400] : [200])); if (body.status === 400) pm.test('no-data response explains the condition', () => pm.expect(body.message).to.be.a('string').and.not.empty); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Authentication (run in order)",
      "item": [
        {
          "name": "1. Login by member phone",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('member login succeeded', () => pm.expect(body.status).to.eql(200));",
                  "pm.collectionVariables.set('accessToken', body.data.access_token);",
                  "pm.collectionVariables.set('memberApiToken', body.data.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{testPhone}}\",\n  \"user_pass\": \"{{testPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/login_app"
          }
        },
        {
          "name": "2. Change password (set newPassword first)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const nextPassword = pm.environment.get('newPassword');",
                  "if (pm.environment.get('runDestructiveTests') !== 'YES' || !nextPassword || nextPassword.length < 6) {",
                  "  console.warn('Password change skipped. Set newPassword (at least 6 characters) and runDestructiveTests = YES to execute it.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('password change succeeded', () => pm.expect(pm.response.code).to.eql(200));",
                  "const body = pm.response.json();",
                  "pm.test('password change returned application success', () => pm.expect(body.status).to.eql(200));",
                  "if (body.status === 200) { pm.environment.set('testPassword', pm.environment.get('newPassword')); pm.environment.unset('newPassword'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{testPassword}}\",\n  \"new_password\": \"{{newPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/update_pass"
          }
        },
        {
          "name": "3. Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('logout succeeded', () => pm.expect(pm.response.code).to.eql(200));",
                  "pm.test('logout returned application success', () => pm.expect(pm.response.json().status).to.eql(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/logout_app"
          }
        },
        {
          "name": "4. Login with the saved (new) password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('login after logout succeeded', () => pm.expect(pm.response.code).to.eql(200));",
                  "const body = pm.response.json();",
                  "pm.test('new password is accepted', () => pm.expect(body.status).to.eql(200));",
                  "if (body.status === 200) { pm.environment.set('accessToken', body.data.access_token); pm.environment.set('memberApiToken', body.data.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{testPhone}}\",\n  \"user_pass\": \"{{testPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/login_app"
          }
        }
      ]
