      "name": "01 Authentication",
      "item": [{
        "name": "Login employee app",
        "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
          "const body = pm.response.json();",
          "pm.test('Returns employee access token', function () { pm.expect(body.data.access_token).to.be.a('string').and.not.empty; });",
          "pm.collectionVariables.set('accessToken', body.data.access_token);"
        ] } }],
        "request": {
          "auth": { "type": "noauth" }, "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{employeeLogin}}\",\n  \"user_pass\": \"{{employeePassword}}\"\n}" },
          "url": "{{baseUrl}}/Api/login_app"
        }
      }, {
