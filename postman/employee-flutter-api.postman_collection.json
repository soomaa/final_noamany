    {
      "name": "12 Authorized live workflows — employee submissions",
      "description": "These requests write real pending employee requests. Run only with allowWrites=true and an authorized employee account. The response IDs are retained only in the active Postman session.",
      "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["if (pm.environment.get('allowWrites') !== 'true') pm.execution.skipRequest();"] } }],
      "item": [
        { "name": "Load eligible live leave type", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const types = pm.response.json().data ?? [];", "const start = new Date(`${pm.environment.get('leaveStartDate')}T12:00:00`);", "const end = new Date(`${pm.environment.get('leaveEndDate')}T12:00:00`);", "const days = Math.floor((end - start) / 86400000) + 1;", "const type = types.find((item) => item.isActive !== false && item.agazaTtype !== 1 && Number(item.minDays ?? 0) <= days && (!item.maxDays || Number(item.maxDays) >= days));", "pm.test('An eligible leave type is available for the requested duration', () => pm.expect(type?.id).to.exist);", "pm.collectionVariables.set('leaveTypeId', type.id);"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/Api/Agazat_types?page=1&per_page=100" } },
        { "name": "Create real permission request", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const id = pm.response.json().data?.id;", "pm.test('Permission request ID is returned', () => pm.expect(id).to.exist);", "pm.collectionVariables.set('permissionId', id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"ezn_type_id\": \"1\", \"ezn_date\": \"{{requestDate}}\", \"from_time\": \"10:00 AM\", \"to_time\": \"11:00 AM\", \"reason\": \"{{testReason}}\" }" }, "url": "{{baseUrl}}/Api/Add_Ezn" } },
        { "name": "Create real leave request", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const id = pm.response.json().data?.id;", "pm.test('Leave request ID is returned', () => pm.expect(id).to.exist);", "pm.collectionVariables.set('leaveId', id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"no3_agaza_id\": \"{{leaveTypeId}}\", \"from_date\": \"{{leaveStartDate}}\", \"to_date\": \"{{leaveEndDate}}\", \"reason\": \"{{testReason}}\" }" }, "url": "{{baseUrl}}/Api/Add_Agaza" } },
        { "name": "Create real loan request", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const id = pm.response.json().data?.id;", "pm.test('Loan request ID is returned', () => pm.expect(id).to.exist);", "pm.collectionVariables.set('loanId', id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"qemt_solaf\": 1, \"sadad_solfa\": 1, \"qst_num\": 1, \"solaf_reason\": \"{{testReason}}\", \"khsm_form_date_m\": \"{{loanDeductionDate}}\" }" }, "url": "{{baseUrl}}/Api/Add_Solfa" } }
      ]
    },
    {
      "name": "13 Authorized workflow actions — manager approval or rejection",
      "description": "Use only with an authorized manager account and request IDs that are currently addressed to that manager. Set allowWrites=true, allowWorkflowActions=true, and workflowAction to accept or reject. The folder applies exactly one selected action to the supplied permissionId and leaveId.",
      "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["if (pm.environment.get('allowWrites') !== 'true' || pm.environment.get('allowWorkflowActions') !== 'true' || !['accept', 'reject'].includes(pm.environment.get('workflowAction'))) pm.execution.skipRequest();"] } }],
      "item": [
        { "name": "Login manager for workflow action", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Manager login succeeded', () => pm.expect(body.status).to.equal(200));", "pm.test('Manager token is returned', () => pm.expect(body.data?.access_token).to.exist);", "pm.collectionVariables.set('managerAccessToken', body.data.access_token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"phone\": \"{{managerLogin}}\", \"user_pass\": \"{{managerPassword}}\" }" }, "url": "{{baseUrl}}/Api/login_app" } },
        { "name": "Permission details for manager", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{managerAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"ezn_id\": \"{{permissionId}}\" }" }, "url": "{{baseUrl}}/Api/Get_Ezn_data" } },
        { "name": "Apply selected action to permission", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Permission action succeeded', () => pm.expect(body.status).to.equal(200));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{managerAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"ezn_id\": \"{{permissionId}}\", \"action_option\": \"{{workflowAction}}\", \"reason\": \"{{actionReason}}\" }" }, "url": "{{baseUrl}}/Api/Egraa_ezn" } },
        { "name": "Leave details for manager", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{managerAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"agaza_id\": \"{{leaveId}}\" }" }, "url": "{{baseUrl}}/Api/Get_Agaza_data" } },
        { "name": "Apply selected action to leave", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.test('Leave action succeeded', () => pm.expect(body.status).to.equal(200));"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{managerAccessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"agaza_id\": \"{{leaveId}}\", \"action_option\": \"{{workflowAction}}\", \"reason\": \"{{actionReason}}\" }" }, "url": "{{baseUrl}}/Api/Egraa_agaza" } }
      ]
    }
  ]
