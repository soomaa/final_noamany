      "const writeActions = ['register_device_token', 'insert_update_token', 'Add_Agaza', 'Add_Agazax', 'Edit_Agaza', 'Delete_agaza', 'Egraa_agaza', 'Add_Ezn', 'Edit_Ezn', 'Delete_ezn', 'Egraa_ezn', 'Add_Solfa', 'Egraa_solfa', 'Delete_solfa', 'Add_Task', 'Delete_task', 'SendMessage', 'SeenMessage', 'DeleteMessage', 'SeenTa3mem', 'SeenEnzar', 'SeenLayha', 'Add_mosala_response', 'Add_Talab', 'Delete_Talab_order', 'Add_Mobadra', 'Delete_Mobadra', 'add_nashat', 'Delete_Nashat', 'Add_location_basma', 'Delete_zeyara', 'update_pass', 'update_pass_past', 'update_profile_image', 'Add_signature', 'Add_Screen_action', 'add_hdor_ensraf', 'add_hdor_ensraf_asly', 'attendance_new', 'attendance', 'add_sheft_edafi', 'add_hours_edafi'];",
      "const requestUrl = pm.request.url.toString();",
      "if (writeActions.some((action) => requestUrl.includes(`/Api/${action}`)) && pm.environment.get('allowWrites') !== 'true') pm.execution.skipRequest();"
    ] }
  }, {
    "listen": "test",
    "script": { "type": "text/javascript", "exec": [
      "pm.test('HTTP response is successful', function () { pm.expect(pm.response.code).to.equal(200); });",
      "const contentType = pm.response.headers.get('Content-Type') || '';",
      "if (contentType.includes('application/json')) {",
      "  const body = pm.response.json();",
      "  pm.test('Legacy API response status is 200', function () { pm.expect(body.status).to.equal(200); });",
      "}"
    ] }
  }],
  "item": [
