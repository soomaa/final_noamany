{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--port", "4179", "--strictPort", "website-redesign"],
      "port": 4179
    },
    {
      "name": "local-api",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:DISABLE_SCHEDULED_TASKS='true'; $env:PORT='4012'; $env:HOST='127.0.0.1'; $env:REDIS_URL=''; Set-Location backend; node dist/main.js"],
      "port": 4012
    },
    {
      "name": "local-dashboard",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:VITE_API_TARGET='http://127.0.0.1:4012'; Set-Location frontend; node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5176 --strictPort"],
      "port": 5176
    },
    {
      "name": "verify-api",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:DISABLE_SCHEDULED_TASKS='true'; $env:PORT='4016'; $env:HOST='127.0.0.1'; $env:REDIS_URL=''; Set-Location backend; node dist/main.js"],
      "port": 4016,
      "autoPort": false
    },
    {
      "name": "verify-dashboard",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:VITE_API_TARGET='http://127.0.0.1:4016'; Set-Location frontend; node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5178 --strictPort"],
      "port": 5178,
      "autoPort": false
    }
  ]
}

