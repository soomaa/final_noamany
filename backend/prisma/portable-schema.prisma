generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum YesNo {
  yes
  no
}

enum HaletKafala {
  kafala
  ajeer
  zeyara
  other
  saudi
  eqama
}

enum TaskenType {
  alone
  family
}

enum No3Emp {
  eshraf
  schools
}

enum WazefaType {
  moder
  emp
}

enum HdoorTtype {
  hdoor
  ensraf
  Out
}

enum TasgelType {
  automatic
  manual
}

enum BookingStatus {
  Aktif
  Nonaktif
}

enum RbacResourceType {
  module
  group
  page
}

enum RbacEffect {
  allow
  deny
}

enum RbacDataScope {
  own
  team
  branch
  department
  global
}

model all_defined_setting {
  defined_id         Int    @id @default(autoincrement())
  defined_title      String @db.VarChar(255)
  defined_type       Int
  defined_type_title String @db.VarChar(255) // e.g. allowances/deduction/type_contract/job_role
  in_order           String @default("0") @db.VarChar(255) // numeric-as-string
  @@map("all_defined_setting")
}

model api_users {
  user_id    Int     @id @default(autoincrement())
  user_name  String? @db.VarChar(100)
  user_phone String? @db.VarChar(20)
  user_email String? @db.VarChar(70)
  user_city  String? @db.VarChar(100)
  user_pass  String? @db.VarChar(500)
  status     Int     @default(0) // tinyint: 0=inactive,1=active
  rand_key   Int?
  m_image    String? @db.Text
  employees employees[]
  @@map("api_users")
}

model attendance_channels {
  id      Int     @id @default(autoincrement())
  key     String  @unique @db.VarChar(20) // device | app | gps | qr | nfc | face
  enabled Int     @default(1) @db.TinyInt
  label   String? @db.VarChar(50)
  @@map("attendance_channels")
}

model attendance_device_events {
  id                   BigInt             @id @default(autoincrement())
  device_id            Int
  provider_event_id    String             @db.VarChar(120)
  employee_code        Int
  occurred_at          DateTime           @db.DateTime(3)
  event_type           String             @db.VarChar(8)
  payload_hash         String             @db.Char(64)
  status               String             @default("received") @db.VarChar(16)
  attendance_record_id Int?
  error_code           String?            @db.VarChar(60)
  received_at          DateTime           @default(now()) @db.DateTime(3)
  processed_at         DateTime?          @db.DateTime(3)
  device               attendance_devices @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attendance_device_events_device")
  @@unique([device_id, provider_event_id], map: "uq_attendance_device_provider_event")
  @@index([device_id, occurred_at], map: "idx_attendance_device_events_occurred")
  @@index([status, received_at], map: "idx_attendance_device_events_status")
  @@map("attendance_device_events")
}

model attendance_devices {
  id                    Int                        @id @default(autoincrement())
  title                 String?                    @db.VarChar(150)
  ip                    String?                    @db.VarChar(50)
  branch_id_fk          Int?
  last_sync             String?                    @db.VarChar(30) // date-time string
  status                String?                    @db.VarChar(20) // online | offline
  created_at            String?                    @db.VarChar(30)
  updated_at            String?                    @db.VarChar(30)
  credential_hash       String?                    @db.Char(64)
  credential_rotated_at DateTime?                  @db.DateTime(3)
  events                attendance_device_events[]
  @@map("attendance_devices")
}

model attendance_rules {
  id         Int     @id @default(autoincrement())
  key        String  @unique @db.VarChar(50) // late | early_leave | absence | overtime | weekly_rest | holidays | flexible_hours
  enabled    Int     @default(1) @db.TinyInt
  threshold  String? @db.VarChar(20)
  grace_min  String? @db.VarChar(20)
  multiplier String? @db.VarChar(20)
  @@map("attendance_rules")
}

model bank_employes_details {
  id                    Int     @id @default(autoincrement())
  emp_code              Int     @default(0) // FK-by-convention -> employees.emp_code
  bank_id_fk            Int     @default(0) // -> banks / banks_settings
  bank_account_num      String  @default("0") @db.VarChar(255)
  bank_code             String? @db.VarChar(10)
  approved_for_sarf     Int     @default(0) @db.TinyInt // bool (approved for payout)
  bank_id_fk_image      String? @default("0") @db.VarChar(700)
  emp_bank_name         String? @db.VarChar(70)
  past_bank_id_fk       Int?
  past_bank_account_num String? @db.VarChar(200)
  past_bank_id_fk_image String? @db.VarChar(200)
  attachment            String? @db.VarChar(200)
  past_attachment       String? @db.VarChar(200)
  @@map("bank_employes_details")
}

model banks {
  id        Int    @id @default(autoincrement())
  bank_name String @db.VarChar(255)
  @@map("banks")
}

model branch_settings {
  id       Int     @id @default(autoincrement())
  title    String  @db.VarChar(255)
  from_id  Int // parent
  lat_map  String? @db.VarChar(200)
  long_map String? @db.VarChar(200)
  @@map("branch_settings")
}

model business_audit_log {
  id             Int      @id @default(autoincrement())
  entity_type    String   @db.VarChar(60)
  entity_id      String   @db.VarChar(60)
  action         String   @db.VarChar(60)
  actor_user_id  Int?
  actor_name     String?  @db.VarChar(150)
  branch_id      Int?
  before_json    Json?
  after_json     Json?
  changed_fields Json?
  reason         String?  @db.Text
  ip_address     String?  @db.VarChar(45)
  correlation_id String?  @db.VarChar(64)
  created_at     DateTime @default(now())
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@index([actor_user_id])
  @@index([branch_id])
  @@index([correlation_id])
  @@map("business_audit_log")
}

model cities {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(300)
  from_id_fk Int    @default(0) // self-ref parent (FK-by-convention)
  in_order   String @default("0") @db.VarChar(255) // numeric-as-string sort order
  @@map("cities")
}

