model contract_employe {
  id                        Int     @id @default(autoincrement())
  emp_code                  String  @default("0") @db.VarChar(255) // FK-by-convention (varchar)
  num_days_in_month         String  @default("0") @db.VarChar(255)
  hours_work                String  @default("0") @db.VarChar(255)
  hour_value                String  @default("0") @db.VarChar(255)
  work_period_id_fk         String  @default("0") @db.VarChar(255)
  contract_nature           Int     @default(0)
  job_type                  String  @default("0") @db.VarChar(255)
  pay_method_id_fk          String  @default("0") @db.VarChar(255)
  bank_id_fk                String  @default("0") @db.VarChar(255)
  bank_code                 String  @default("255") @db.VarChar(255)
  bank_account_num          String  @default("0") @db.VarChar(255)
  year_vacation_num         String  @default("0") @db.VarChar(255)
  year_vacation_period      String  @default("0") @db.VarChar(255)
  casual_vacation_num       String  @default("0") @db.VarChar(255)
  travel_ticket             String  @default("0") @db.VarChar(255)
  travel_type_fk            String  @default("0") @db.VarChar(255)
  travel_period             String  @default("0") @db.VarChar(255)
  reward_end_work           Int     @default(0) @db.TinyInt // bool
  vacation_previous_balance Float
  vacation_start_ar         String  @db.VarChar(255) // date-string
  vacation_start_m          String? @db.VarChar(15) // date-string Gregorian
  vacation_start_h          String? @db.VarChar(15) // date-string Hijri
  travel_type_name          String? @db.VarChar(30)
  @@unique([emp_code])
  @@map("contract_employe")
}

model custody_devices {
  id      Int     @id @default(autoincrement())
  title   String? @db.VarChar(300)
  from_id Int?    @default(0)
  level   Int?
  @@map("custody_devices")
}

model department_jobs {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(255)
  from_id_fk Int     @default(0) // parent job/dept (self-ref FK-by-convention)
  status     Int     @default(0)
  in_order   String  @default("0") @db.VarChar(255) // numeric-as-string
  dep_code   Int?
  edara_id   Int? // -> hr_edarat_aqsam / departments
  is_trainer Boolean @default(false)
  @@map("department_jobs")
}

model departments {
  id            Int    @id @default(autoincrement())
  main_dep_name String @db.VarChar(255)
  main_dep_f_id String @db.VarChar(255) // parent id as string
  sub_dep_name  String @db.VarChar(255)
  detail        String @db.VarChar(255)
  type          Int    @db.TinyInt
  suspend       Int    @db.TinyInt // bool
  date          String @db.VarChar(255) // date-string
  date_s        String @db.VarChar(255) // date-string
  publisher     String @db.VarChar(255)
  deleted       Int    @default(1) @db.TinyInt // soft-delete (VERIFY polarity: 1 likely = active)
  @@map("departments")
}

model document_number_series {
  series_key String   @id @db.VarChar(80)
  next_value BigInt
  updated_at DateTime @updatedAt @db.DateTime(3)
  @@map("document_number_series")
}

model emp_custody {
  id            Int     @id @default(autoincrement())
  emp_code      Int?
  custody_id_fk Int?
  custody_title String? @db.VarChar(255)
  num           Int?
  status        Int?
  date_recived  String? @db.VarChar(255)
  transfered    Int?
  @@map("emp_custody")
}

model emp_custody_transfer_operations {
  id              Int    @id @default(autoincrement())
  custody_id_fk   Int
  from_emp_code   Int
  to_emp_code     Int
  date            Int
  date_ar         String @db.VarChar(20)
  date_s          Int
  publisher       String @db.VarChar(100)
  @@index([custody_id_fk])
  @@index([from_emp_code])
  @@index([to_emp_code])
  @@map("emp_custody_transfer_operations")
}

model emp_files {
  id          Int     @id @default(autoincrement())
  emp_id      Int? // -> employees.id (safe relation)
  emp_code    String  @default("0") @db.VarChar(255) // FK-by-convention (varchar)
  title       String  @db.VarChar(400)
  emp_file    String  @db.Text // path
  tanbih_fk   Int?    @db.TinyInt // alert flag
  period      Int?    @db.TinyInt
  have_date   Int     @default(0) @db.TinyInt // bool
  from_date   String? @db.VarChar(15) // date-string
  from_date_h String? @db.VarChar(15) // date-string Hijri
  to_date     String? @db.VarChar(15) // date-string
  to_date_h   String? @db.VarChar(15) // date-string Hijri
  employee employees? @relation(fields: [emp_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([emp_id])
  @@map("emp_files")
}

