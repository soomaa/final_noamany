  @@map("rbac_actions")
}

model rbac_resource_actions {
  resource_id Int
  action_id   Int
  resource rbac_resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  action   rbac_actions   @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@id([resource_id, action_id])
  @@index([action_id])
  @@map("rbac_resource_actions")
}

model rbac_resources {
  id         Int              @id @default(autoincrement())
  key        String           @unique @db.VarChar(120) // stable, e.g. "employees.list"
  parent_id  Int?
  type       RbacResourceType
  name_ar    String           @db.VarChar(160)
  name_en    String?          @db.VarChar(160)
  route      String?          @db.VarChar(200) // new React route, e.g. "/employees"
  icon       String?          @db.VarChar(80)
  sort_order Int              @default(0)
  is_active  Boolean          @default(true)
  parent   rbac_resources?  @relation("rbac_resource_tree", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children rbac_resources[] @relation("rbac_resource_tree")
  resource_actions rbac_resource_actions[]
  role_permissions rbac_role_permissions[]
  exceptions       rbac_user_exceptions[]
  role_scopes      rbac_role_scopes[]
  @@index([parent_id])
  @@map("rbac_resources")
}

model rbac_role_permissions {
  id          Int        @id @default(autoincrement())
  role_id     Int
  resource_id Int
  action_id   Int
  effect      RbacEffect
  role     rbac_roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource rbac_resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  action   rbac_actions   @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@unique([role_id, resource_id, action_id])
  @@index([role_id])
  @@index([resource_id])
  @@index([action_id])
  @@map("rbac_role_permissions")
}

model rbac_role_scopes {
  id          Int           @id @default(autoincrement())
  role_id     Int
  resource_id Int
  scope       RbacDataScope
  role     rbac_roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource rbac_resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@unique([role_id, resource_id])
  @@index([role_id])
  @@map("rbac_role_scopes")
}

model rbac_roles {
  id             Int      @id @default(autoincrement())
