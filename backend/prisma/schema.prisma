enum InvItemStatus {
  active
  inactive
}

enum WarehouseType {
  main
  sub
}

enum StockOperation {
  add
  subtract
  set
}

enum SparePartCondition {
  new
  used
  refurbished
}

enum MovementDirection {
  in
  out
}

enum InventoryTxnType {
  receipt
  issue
  transfer
  count
  damage
  manufacturing
  purchase_return
  sales_return
  adjustment
}

enum InventoryTxnStatus {
  draft
  approved
  rejected
}

