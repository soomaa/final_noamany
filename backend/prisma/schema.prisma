  warehouse_id      Int?
  receiver_name     String                    @db.VarChar(150)
  receipt_date      String?                   @db.VarChar(10)
  notes             String?                   @db.Text
  status            String                    @default("draft") @db.VarChar(20)
  stock_posted      Boolean                   @default(false)
  posted_at         DateTime?
  branch_id         Int?
  created_by        Int?
  is_deleted        Boolean                   @default(false)
  created_at        DateTime                  @default(now())
  updated_at        DateTime                  @updatedAt
  purchase_order    prc_purchase_orders       @relation(fields: [purchase_order_id], references: [id])
  items             prc_goods_receipt_items[]
  purchase_invoices prc_purchase_invoices[]

  @@index([purchase_order_id])
  @@index([status])
  @@index([warehouse_id])
  @@map("prc_goods_receipts")
}

model prc_goods_receipt_items {
  id               Int                @id @default(autoincrement())
  goods_receipt_id Int
  product_id       Int?
  name             String             @db.VarChar(255)
  ordered_qty      Decimal            @db.Decimal(14, 3)
  received_qty     Decimal            @db.Decimal(14, 3)
  unit             String?            @db.VarChar(40)
