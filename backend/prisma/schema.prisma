/// Member-facing app notifications. One row per recipient (broadcasts are fanned out on
/// create). Read state (is_read / read_at) is tracked per row. member_id is FK-by-convention
/// to club_members.id (no relation, matching am_* conventions).
model am_member_notifications {
  id         Int       @id @default(autoincrement())
  member_id  Int
  branch_id  Int?
  title      String    @db.VarChar(200)
  body       String    @db.Text
  type       String    @default("general") @db.VarChar(40) // general | subscription | freeze | offer | class | points
  data       String?   @db.Text // optional JSON payload (deep-link target, related ids)
  image_url  String?   @db.VarChar(500)
  is_read    Boolean   @default(false)
  read_at    DateTime?
  is_active  Boolean   @default(true)
  created_by Int?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([member_id])
  @@index([member_id, is_read])
  @@index([branch_id])
  @@index([created_at])
  @@map("am_member_notifications")
}

model users {
  user_id              Int     @id @default(autoincrement())
  agent_brok_fk        Int? // FK-by-convention
  emp_code             Int? // FK-by-convention -> employees.emp_code (varchar/int mismatch; not enforced)
  username             String? @db.VarChar(40)
  password             String? @db.VarChar(255) // bcrypt going forward; legacy sha1(md5) tolerated until rehash on login
  name                 String? @db.VarChar(100)
  email                String? @db.VarChar(50)
  address              String? @db.VarChar(200)
  level                Int? // COMMENT '1:admin , 2:emp'
  role_id_fk           Int? // FK-by-convention -> role (out of scope)
  image                String? @db.VarChar(500)
  x_y_z                String? @db.VarChar(300)
  branch_id_fk         Int? // FK-by-convention -> tbl_branches.branch_id
  app_pass             String? @db.VarChar(100) // SHA-1 hex (mobile)
  approved             Int?    @default(1) // bool-as-int
  pass_demo            String? @db.VarChar(100)
  user_pass            String? @db.VarChar(500) // duplicate password store
  device_token         String  @default("") @db.VarChar(255) // legacy NOT NULL w/o default — defaulted for strict InnoDB
  must_change_password Boolean @default(false)

  // Safe relation: permissions junction keyed by user_id (int = int).
  permissions             permissions[]
  legacy_mappings         legacy_user_mappings[]
  community_replied_posts community_posts[]      @relation("community_post_replied_by")

  @@map("users")
}

/// Durable old-to-new user ID mapping used by the user-only legacy migration.
model legacy_user_mappings {
  id          Int      @id @default(autoincrement())
  source_key  String   @db.VarChar(191)
  legacy_id   Int
  new_user_id Int
  username    String?  @db.VarChar(40)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user        users    @relation(fields: [new_user_id], references: [user_id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([source_key, legacy_id], map: "uq_legacy_user_source")
  @@index([new_user_id], map: "idx_legacy_user_target")
  @@index([source_key, username], map: "idx_legacy_user_username")
  @@map("legacy_user_mappings")
}

/// One immutable legacy dump import. Operational import scripts use this row
/// to make reruns idempotent and to retain the source checksum/reconciliation.
model legacy_import_runs {
  id                 Int                            @id @default(autoincrement())
  source_key         String                         @db.VarChar(191)
  source_database    String                         @db.VarChar(191)
  dump_sha256        String                         @db.Char(64)
  status             String                         @default("running") @db.VarChar(30)
  source_table_count Int                            @default(0)
  source_row_count   BigInt                         @default(0)
  started_at         DateTime                       @default(now())
  completed_at       DateTime?
  notes              String?                        @db.Text
  mappings           legacy_record_mappings[]
  reconciliations    legacy_table_reconciliations[]

  @@unique([source_key, dump_sha256], map: "uq_legacy_import_source_dump")
  @@index([status])
  @@map("legacy_import_runs")
}

/// Stable old-ID to new-ID map for every canonical entity produced from the
/// archived legacy database. The unique key makes every import step rerunnable.
model legacy_record_mappings {
  id             BigInt             @id @default(autoincrement())
  run_id         Int
  source_key     String             @db.VarChar(191)
  legacy_table   String             @db.VarChar(100)
  legacy_id      String             @db.VarChar(191)
  target_table   String             @db.VarChar(100)
  target_id      Int?
  mapping_status String             @default("mapped") @db.VarChar(30)
  details        Json?
  created_at     DateTime           @default(now())
  run            legacy_import_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([source_key, legacy_table, legacy_id, target_table], map: "uq_legacy_record_target")
  @@index([run_id, legacy_table])
  @@index([target_table, target_id])
  @@map("legacy_record_mappings")
}

/// Per-table source, canonical-map and archive counts captured by validation.
model legacy_table_reconciliations {
  id            Int                @id @default(autoincrement())
  run_id        Int
  source_table  String             @db.VarChar(100)
  target_table  String             @default("") @db.VarChar(100)
  source_rows   BigInt             @default(0)
  mapped_rows   BigInt             @default(0)
  archived_rows BigInt             @default(0)
  error_rows    BigInt             @default(0)
  notes         String?            @db.Text
  checked_at    DateTime           @default(now())
  run           legacy_import_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([run_id, source_table, target_table], map: "uq_legacy_reconciliation")
  @@index([error_rows])
  @@map("legacy_table_reconciliations")
}

