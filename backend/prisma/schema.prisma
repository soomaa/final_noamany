  created_at    DateTime              @default(now())
  workflow      automation_workflows  @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([workflow_id])
  @@index([created_at])
  @@map("automation_runs")
}

/// Staff tasks created by automation or manually (sales follow-up, renewals).
model staff_tasks {
  id              Int               @id @default(autoincrement())
