  id           BigInt   @id @default(autoincrement())
  source_key   String   @db.VarChar(191)
  source_table String   @db.VarChar(100)
  source_id    String   @db.VarChar(191)
  source_field String   @db.VarChar(100)
  file_path    String   @db.VarChar(1000)
  target_table String?  @db.VarChar(100)
  target_id    Int?
  availability String   @default("missing") @db.VarChar(30)
  checked_at   DateTime @default(now())
  created_at   DateTime @default(now())

  @@unique([source_key, source_table, source_id, source_field], map: "uq_legacy_media_source")
  @@index([availability])
  @@index([target_table, target_id])
  @@map("legacy_media_references")
}

