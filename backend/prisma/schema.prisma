  challenge
  workshop
  bootcamp
  seminar
  open_day
  community
  kids_activity
  campaign
}

enum ClubEventStatus {
  draft
  pending_approval
  approved
  rejected
  published
  ongoing
  completed
  closed
  cancelled
}

enum ClubEventVisibility {
  internal
  members
  public
}

enum ClubEventRegistrantType {
  member
  guest
  lead
}

enum ClubEventRegStatus {
  pending_payment
  confirmed
  waitlisted
  cancelled
  refunded
}

enum ClubEventPaymentType {
