  end_date                     String                        @db.VarChar(10)
  start_time                   String?                       @db.VarChar(8)
  end_time                     String?                       @db.VarChar(8)
  registration_opens           String?                       @db.VarChar(10)
  registration_closes          String?                       @db.VarChar(10)
  registration_paused          Boolean                       @default(false)
  max_capacity                 Int                           @default(0)
  waitlist_capacity            Int                           @default(0)
  visibility                   ClubEventVisibility           @default(members)
  status                       ClubEventStatus               @default(draft)
  is_free                      Boolean                       @default(false)
  allow_guests                 Boolean                       @default(false)
  requires_active_subscription Boolean                       @default(true)
  min_age                      Int?
  max_age                      Int?
  requires_guardian_consent    Boolean                       @default(false)
  campaign_tag                 String?                       @db.VarChar(100)
  show_in_app                  Boolean                       @default(false)
  registrations_count          Int                           @default(0)
  attended_count               Int                           @default(0)
  closing_notes                String?                       @db.Text
  closed_by                    Int?
  closed_at                    DateTime?
  approved_by                  Int?
