// =====================================================================================
//  CLUB FITNESS — training, scheduling, trainers, facilities, SPA, InBody
// =====================================================================================

enum ClubFitnessClassStatus {
  scheduled
  ongoing
  completed
  cancelled
}

enum ClubClassAudience {
  men
  women
  kids
  mixed
}

enum ClubFitnessEnrollmentStatus {
  registered
  attended
  absent
  cancelled
}

enum ClubFitnessHallStatus {
  available
  maintenance
  unavailable
}

enum ClubFitnessBookingStatus {
  pending
  confirmed
  active
  completed
  cancelled
}

enum ClubFitnessDifficulty {
  easy
  medium
  hard
}

enum ClubFitnessPaymentStatus {
  unpaid
  paid
  partial
}

model club_trainers {
  id                     Int                                   @id @default(autoincrement())
  employee_id            Int?                                  @unique // 1:1 with an employee when auto-synced from a trainer job title
  name                   String                                @db.VarChar(200)
  email                  String?                               @db.VarChar(150)
  phone                  String?                               @db.VarChar(20)
  specialization         String?                               @db.VarChar(200)
  experience             String?                               @db.VarChar(100)
  bio                    String?                               @db.Text
  image_url              String?                               @db.VarChar(255)
  rating_avg             Decimal                               @default(0) @db.Decimal(3, 2)
  is_active              Boolean                               @default(true)
  is_deleted             Boolean                               @default(false)
  created_at             DateTime                              @default(now())
  updated_at             DateTime                              @updatedAt
  salaries               club_trainer_salaries[]
  ratings                club_trainer_ratings[]
  classes                club_classes[]
  eligible_classes       club_class_type_trainers[]
  schedule_slots         club_class_schedule_slots[]
  default_schedule_slots club_trainer_schedule_slots[]
  earning_payments       club_trainer_earning_payments[]
  private_subscriptions  club_subscriptions[]
  private_commissions    club_private_attendance_commissions[]
  event_sessions         club_event_sessions[]
  event_staff            club_event_staff[]
  target_periods         club_trainer_target_periods[]

  @@map("club_trainers")
}

model club_trainer_salaries {
  id                                 Int           @id @default(autoincrement())
  trainer_id                         Int
  base_salary                        Decimal       @db.Decimal(10, 2)
  class_commission_percentage        Decimal       @default(0) @db.Decimal(5, 2)
  subscription_commission_percentage Decimal       @default(0) @db.Decimal(5, 2)
  private_commission_percentage      Decimal       @default(0) @db.Decimal(5, 2)
  monthly_target                     Decimal       @default(0) @db.Decimal(12, 2)
  effective_date                     String        @db.VarChar(10)
  end_date                           String?       @db.VarChar(10)
  is_active                          Boolean       @default(true)
  notes                              String?       @db.Text
  created_at                         DateTime      @default(now())
  updated_at                         DateTime      @updatedAt
  trainer                            club_trainers @relation(fields: [trainer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([trainer_id])
  @@map("club_trainer_salaries")
}

/// A trainer target is selected and saved for one exact calendar month. The unique month key
/// prevents overlapping monthly targets while preserving the full history for reports.
model club_trainer_target_periods {
  id           Int           @id @default(autoincrement())
  trainer_id   Int
  period_month String        @db.VarChar(7)
  period_start String        @db.VarChar(10)
  period_end   String        @db.VarChar(10)
  target_value Decimal       @default(0) @db.Decimal(12, 2)
  target_unit  String        @default("members") @db.VarChar(20)
  notes        String?       @db.VarChar(500)
  created_by   Int?
  updated_by   Int?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  trainer      club_trainers @relation(fields: [trainer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([trainer_id, period_month])
  @@index([period_start, period_end])
  @@map("club_trainer_target_periods")
}

model club_trainer_ratings {
  id            Int              @id @default(autoincrement())
  trainer_id    Int
  member_id     Int?
  attendance_id Int?             @unique
  rating        Decimal          @db.Decimal(3, 2)
  comment       String?          @db.Text
  created_at    DateTime         @default(now())
  trainer       club_trainers    @relation(fields: [trainer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member        club_members?    @relation(fields: [member_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  attendance    club_attendance? @relation(fields: [attendance_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([trainer_id])
  @@index([member_id])
  @@map("club_trainer_ratings")
}

model club_halls {
  id                     Int                           @id @default(autoincrement())
  name                   String                        @db.VarChar(150)
  hall_number            String                        @db.VarChar(30)
  capacity               Int
  branch_id              Int
  description            String?                       @db.Text
  status                 ClubFitnessHallStatus         @default(available)
  is_deleted             Boolean                       @default(false)
  created_at             DateTime                      @default(now())
  updated_at             DateTime                      @updatedAt
  bookings               club_hall_bookings[]
  classes                club_classes[]
  schedule_slots         club_class_schedule_slots[]
  trainer_schedule_slots club_trainer_schedule_slots[]

  @@unique([branch_id, hall_number])
  @@index([branch_id])
  @@map("club_halls")
}

model club_hall_bookings {
  id               Int                      @id @default(autoincrement())
  hall_id          Int
  member_id        Int?
  customer_name    String?                  @db.VarChar(200)
  booking_date     String                   @db.VarChar(10)
  start_time       String                   @db.VarChar(8)
  end_time         String                   @db.VarChar(8)
  number_of_people Int                      @default(1)
  status           ClubFitnessBookingStatus @default(pending)
  notes            String?                  @db.Text
  is_deleted       Boolean                  @default(false)
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt
  hall             club_halls               @relation(fields: [hall_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hall_id])
  @@index([booking_date])
  @@map("club_hall_bookings")
}

/// The reusable class definition (Yoga, Zumba, CrossFit). Actual dated sessions live in club_classes.
model club_class_types {
  id                          Int                              @id @default(autoincrement())
  name                        String                           @unique @db.VarChar(150)
  color                       String                           @default("#2563EB") @db.VarChar(20)
  default_duration_minutes    Int                              @default(60)
  single_session_price        Decimal                          @default(0) @db.Decimal(10, 2)
  subscription_sessions_count Int                              @default(1)
  subscription_validity_days  Int                              @default(30)
  use_default_schedule        Boolean                          @default(false)
  is_active                   Boolean                          @default(true)
  is_deleted                  Boolean                          @default(false)
  created_at                  DateTime                         @default(now())
  updated_at                  DateTime                         @updatedAt
  eligible_trainers           club_class_type_trainers[]
  schedule_slots              club_class_schedule_slots[]
  sessions                    club_classes[]
  subscription_types          club_subscription_type_classes[]
  trainer_schedule_slots      club_trainer_schedule_slots[]
  special_subscriptions       club_subscriptions[]

  @@index([is_active, is_deleted])
  @@map("club_class_types")
}

/// A weekly template for one trainer inside one class type. Class calendars are generated
/// only from rows that belong to the selected class type and trainer pair.
model club_trainer_schedule_slots {
  id            Int              @id @default(autoincrement())
  class_type_id Int
  trainer_id    Int
  weekday       Int
  start_time    String           @db.VarChar(8)
  end_time      String           @db.VarChar(8)
  branch_id     Int
  hall_id       Int?
  max_capacity  Int              @default(10)
  is_active     Boolean          @default(true)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  class_type    club_class_types @relation(fields: [class_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  trainer       club_trainers    @relation(fields: [trainer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  hall          club_halls?      @relation(fields: [hall_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions      club_classes[]

  @@unique([class_type_id, trainer_id, weekday, start_time, branch_id], map: "uq_class_trainer_weekly_slot")
  @@index([class_type_id, weekday])
  @@index([trainer_id, weekday])
  @@index([branch_id])
  @@map("club_trainer_schedule_slots")
}

model club_class_type_trainers {
  class_type_id Int
  trainer_id    Int
  created_at    DateTime         @default(now())
  class_type    club_class_types @relation(fields: [class_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  trainer       club_trainers    @relation(fields: [trainer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([class_type_id, trainer_id])
  @@index([trainer_id])
  @@map("club_class_type_trainers")
}

/// Weekly template only; it never represents attendance or a real session.
model club_class_schedule_slots {
  id                 Int              @id @default(autoincrement())
  class_type_id      Int
  weekday            Int // 0 = Sunday, 6 = Saturday
  start_time         String           @db.VarChar(8)
  end_time           String           @db.VarChar(8)
  branch_id          Int
  hall_id            Int?
  trainer_id         Int?
  max_capacity       Int              @default(10)
  price              Decimal          @default(0) @db.Decimal(10, 2)
  is_active          Boolean          @default(true)
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  class_type         club_class_types @relation(fields: [class_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
