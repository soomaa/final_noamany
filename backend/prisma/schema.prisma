  @@index([event_id])
  @@index([session_date])
  @@index([trainer_id])
  @@index([hall_id, session_date])
  @@map("club_event_sessions")
}

model club_event_ticket_tiers {
  id               Int                        @id @default(autoincrement())
  event_id         Int
  name             String                     @db.VarChar(150)
  audience         ClubEventRegistrantType?
  min_age          Int?
  max_age          Int?
  price            Decimal                    @db.Decimal(10, 2)
  early_bird_price Decimal?                   @db.Decimal(10, 2)
  early_bird_until String?                    @db.VarChar(10)
