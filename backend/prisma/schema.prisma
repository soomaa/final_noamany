model prc_purchase_order_items {
  id                Int                 @id @default(autoincrement())
  purchase_order_id Int
  product_id        Int?
  name              String              @db.VarChar(255)
  quantity          Decimal             @db.Decimal(14, 3)
  unit              String?             @db.VarChar(40)
