// Noamany Fitness Center — Prisma schema (Phase 1 scope: Foundation, Auth/RBAC, Dashboard, Employees)
// Source: noamanycenter_hr.sql (CodeIgniter 3 legacy, MySQL 8.0.46). 40 scope tables.
//
// FAITHFULNESS RULES APPLIED:
//   * All table/column names preserved via @@map / @map (snake_case kept as-is).
//   * VARCHAR-stored dates kept as String (commented "// date-string ..."). NEVER auto-cast.
//   * enum('yes','no') and other enums kept as native Prisma enums to preserve exact stored values
//     (NOT Boolean — legacy stores literal 'yes'/'no').
//   * tinyint/int boolean-ish flags kept as Int (magic values) unless clearly tinyint(1) -> Boolean.
//   * Original engine/charset noted per model. Target migration -> InnoDB + utf8mb4.
//   * Relations: only SAFE, single-typed id links declared. Dual-keyed / varchar emp_code / uncertain
//     links are left as plain scalar columns with a "// FK-by-convention" comment (do NOT enforce yet).
//
// PKs & AUTO_INCREMENT come from trailing ALTER TABLE in the dump (not inline).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================================================================================
//  ENUMS (deduplicated; legacy stores the literal lowercase string)
// =====================================================================================

enum YesNo {
  yes
  no
}

enum HaletKafala {
  kafala
  ajeer
  zeyara
  other
  saudi
  eqama
}

enum TaskenType {
  alone
  family
}

enum No3Emp {
  eshraf
  schools
}

enum WazefaType {
  moder
  emp
}

enum HdoorTtype {
  hdoor
  ensraf
  Out
}

enum TasgelType {
  automatic
  manual
}

enum HdodrBranche {
  all
  aja
}

enum No3Dawam {
  full
  half
}

enum GymSettingType {
  target
  proten
  classes
}

enum BrCode {
  A
  B
  C
  EMPTY @map("")
}

enum CountryFromType {
  country
  city
  region
}

enum BookingStatus {
  Aktif
  Nonaktif
}

// =====================================================================================
//  FOUNDATION / CONFIG
// =====================================================================================

/// Institute-wide singleton. Rebrand anchor: institute_name => "Noamany Fitness Center".
/// Engine=InnoDB, charset=utf8mb3. PK id (no AUTO_INCREMENT).
model global_settings {
  id                   Int      @id
  institute_name       String   @db.VarChar(255)
  institute_code       String   @db.VarChar(255)
  use_barcode          String?  @db.VarChar(3) // bool-as-string
  reg_prefix           String   @db.VarChar(255)
  institute_email      String   @db.VarChar(100)
  address              String   @db.Text
  mobileno             String   @db.VarChar(100)
  logo                 String?  @db.VarChar(500)
  currency             String   @db.VarChar(100)
  currency_symbol      String   @db.VarChar(100)
  sms_service_provider String   @db.VarChar(100)
  session_id           Int
  translation          String   @db.VarChar(100)
  footer_text          String   @db.VarChar(255)
  animations           String   @db.VarChar(100)
  timezone             String   @db.VarChar(100)
  date_format          String   @db.VarChar(100) // HAZARD: original CHARSET utf32
  facebook_url         String   @db.VarChar(255)
  twitter_url          String   @db.VarChar(255)
  linkedin_url         String   @db.VarChar(255)
  youtube_url          String   @db.VarChar(255)
  instagram_url        String?  @db.VarChar(200)
  snapchat_url         String?  @db.VarChar(200)
  cron_secret_key      String?  @db.VarChar(255)
  preloader_backend    Int?     @default(1) @db.TinyInt // tinyint(1) -> boolean
  cms_default_branch   Int // FK-by-convention -> tbl_branches.branch_id
  created_at           DateTime @default(now()) @db.Timestamp(0)
  updated_at           DateTime @db.DateTime(0)
  ketm_image           String?  @db.VarChar(200)
  alert_days_contract  Int? // dashboard alert window (contracts)
  alert_days_quest     Int? // dashboard alert window (iqama/residency)

  @@map("global_settings")
}

