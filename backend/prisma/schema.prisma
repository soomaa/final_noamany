// =====================================================================================
//  FINANCIAL ACCOUNTING (المحاسبة المالية — GL / double-entry)
// =====================================================================================

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum NormalBalance {
  debit
  credit
}

enum JournalEntryStatus {
  draft
  posted
  reversed
}

enum PeriodStatus {
  open
  closed
  locked
}

model acc_accounts {
  id             Int                       @id @default(autoincrement())
  code           String                    @unique @db.VarChar(50)
  name           String                    @db.VarChar(255)
  account_type   AccountType
  normal_balance NormalBalance
  parent_id      Int?
  is_postable    Boolean                   @default(true)
  category       String?                   @db.VarChar(255)
  description    String?                   @db.Text
  branch_id      Int?
  is_active      Boolean                   @default(true)
  created_at     DateTime                  @default(now())
  updated_at     DateTime                  @updatedAt
  parent         acc_accounts?             @relation("AccountTree", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       acc_accounts[]            @relation("AccountTree")
  lines          acc_journal_entry_lines[]

  @@index([parent_id])
  @@index([account_type])
  @@index([branch_id])
  @@map("acc_accounts")
}

model acc_accounting_periods {
  id         Int          @id @default(autoincrement())
  name       String       @db.VarChar(50)
  start_date String       @db.VarChar(10)
  end_date   String       @db.VarChar(10)
  status     PeriodStatus @default(open)
  closed_by  Int?
  closed_at  DateTime?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  @@unique([start_date, end_date])
  @@index([status])
  @@map("acc_accounting_periods")
}

model acc_journal_entries {
  id              Int                       @id @default(autoincrement())
  entry_no        String                    @unique @db.VarChar(50)
  date            String                    @db.VarChar(10)
  period_id       Int?
  branch_id       Int?
  description     String?                   @db.Text
  reference       String?                   @db.VarChar(255)
  status          JournalEntryStatus        @default(draft)
  source_module   String?                   @db.VarChar(40)
  source_doc_type String?                   @db.VarChar(60)
  source_doc_id   String?                   @db.VarChar(80)
  source_version  Int                       @default(1)
  total_debit     Decimal                   @default(0) @db.Decimal(15, 2)
  total_credit    Decimal                   @default(0) @db.Decimal(15, 2)
  reverses_id     Int?
  reversed_by_id  Int?
  reversal_reason String?                   @db.Text
  created_by      Int?
  posted_by       Int?
  posted_at       DateTime?
  created_at      DateTime                  @default(now())
  updated_at      DateTime                  @updatedAt
  lines           acc_journal_entry_lines[]
  reverses        acc_journal_entries?      @relation("Reversal", fields: [reverses_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversed_by     acc_journal_entries[]     @relation("Reversal")

  @@unique([source_module, source_doc_type, source_doc_id, source_version], map: "uq_acc_source_doc_version")
  @@index([date])
  @@index([status])
  @@index([branch_id])
  @@index([status, date, branch_id], map: "idx_acc_entries_dashboard")
  @@map("acc_journal_entries")
}

model acc_journal_entry_lines {
  id          Int                 @id @default(autoincrement())
  entry_id    Int
  account_id  Int
  debit       Decimal             @default(0) @db.Decimal(15, 2)
  credit      Decimal             @default(0) @db.Decimal(15, 2)
  description String?             @db.Text
  line_order  Int                 @default(0)
  created_at  DateTime            @default(now())
  entry       acc_journal_entries @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  account     acc_accounts        @relation(fields: [account_id], references: [id], onDelete: NoAction)

  @@index([entry_id])
  @@index([account_id])
  @@map("acc_journal_entry_lines")
}

model acc_settings {
  id                Int      @id @default(autoincrement())
  fiscal_year_start String   @default("01-01") @db.VarChar(5)
  base_currency     String   @default("EGP") @db.VarChar(8)
  currency_symbol   String   @default("ج.م") @db.VarChar(8)
  require_approval  Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("acc_settings")
}

model acc_default_accounts {
  id           Int      @id @default(autoincrement())
  key          String   @db.VarChar(60)
  account_code String   @db.VarChar(50)
  branch_id    Int?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([key, branch_id], map: "uq_acc_default_key_branch")
  @@map("acc_default_accounts")
}

