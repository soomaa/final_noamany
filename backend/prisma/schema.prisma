  rfq_id        Int
  supplier_id   Int
  total_price   Decimal  @db.Decimal(14, 2)
  delivery_time String?  @db.VarChar(60)
  payment_terms String?  @db.VarChar(150)
  received_date String?  @db.VarChar(10)
  status        String   @default("received") @db.VarChar(30)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  rfq           prc_rfqs @relation(fields: [rfq_id], references: [id], onDelete: Cascade)

  @@index([rfq_id])
  @@index([supplier_id])
  @@map("prc_quotations")
}

model prc_purchase_orders {
  id                     Int                        @id @default(autoincrement())
  po_number              String                     @unique @db.VarChar(40)
  requisition_id         Int?
  supplier_id            Int
  expected_delivery_date String?                    @db.VarChar(10)
  payment_terms          String?                    @db.VarChar(150)
  notes                  String?                    @db.Text
  status                 String                     @default("draft") @db.VarChar(20)
  total_amount           Decimal                    @default(0) @db.Decimal(14, 2)
  branch_id              Int?
  created_by             Int?
  is_deleted             Boolean                    @default(false)
  created_at             DateTime                   @default(now())
  updated_at             DateTime                   @updatedAt
  requisition            prc_requisitions?          @relation(fields: [requisition_id], references: [id], onDelete: SetNull)
  items                  prc_purchase_order_items[]
  goods_receipts         prc_goods_receipts[]
  purchase_invoices      prc_purchase_invoices[]

  @@index([supplier_id])
  @@index([status])
  @@map("prc_purchase_orders")
