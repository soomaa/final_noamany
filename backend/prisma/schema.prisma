/// RBAC junction user<->page. Engine=InnoDB, utf8mb3, 6572 rows.
/// HAZARD: original table has NO primary key / NO index. We synthesize a composite PK here.
/// VERIFY (user_id, page_id_fk) is unique before migrating; otherwise switch to a surrogate id.
model permissions {
  user_id    Int // -> users.user_id
  page_id_fk Int // -> pages.page_id
  page_level Int // access level

  user users @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  page pages @relation(fields: [page_id_fk], references: [page_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, page_id_fk])
  @@index([page_id_fk])
  @@map("permissions")
}

