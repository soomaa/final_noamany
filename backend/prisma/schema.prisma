/// Content and operational records managed by the public website portal.
/// `record_type` identifies the legacy screen (slider, gallery, job, order, ...)
/// while `data` preserves the screen-specific fields without lossy schema churn.
model portal_records {
  id          Int      @id @default(autoincrement())
  record_type String   @db.VarChar(80)
  title       String?  @db.VarChar(500)
  status      String   @default("active") @db.VarChar(40)
  branch_id   Int?
  data        Json?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_by  Int?
  updated_by  Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([record_type, status])
  @@index([record_type, branch_id])
  @@index([record_type, sort_order])
  @@map("portal_records")
}

/// Singleton-like settings documents for website basics and the About page.
model portal_settings {
  id          Int      @id @default(autoincrement())
  setting_key String   @unique @db.VarChar(80)
  data        Json?
  updated_by  Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("portal_settings")
}

/// Hierarchical country/city/region lookup. Engine=InnoDB, utf8mb3. PK main_id (AI). KEY from_id.
model conf_country_setting {
  main_id   Int              @id @default(autoincrement())
  name      String?          @db.VarChar(100)
  from_id   Int? // self-ref parent (declared KEY in dump)
  from_type CountryFromType?
  created   DateTime         @default(now()) @db.DateTime(0)
  updated   DateTime?        @db.DateTime(0)

  @@index([from_id])
  @@map("conf_country_setting")
}

/// Newer hierarchical city list. Engine=InnoDB, utf8mb3. PK id (AI).
model cities {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(300)
  from_id_fk Int    @default(0) // self-ref parent (FK-by-convention)
  in_order   String @default("0") @db.VarChar(255) // numeric-as-string sort order

  @@map("cities")
}

/// Legacy city list. Engine=MyISAM, TABLE charset=latin1 (column overridden utf8mb3). PK city_id (AI).
model tbl_city {
  city_id   Int     @id @default(autoincrement())
  city_name String? @db.VarChar(100)

  @@map("tbl_city")
}

// =====================================================================================
//  BRANCHES
// =====================================================================================

/// LIVE canonical branch entity. Engine=InnoDB, utf8mb3_unicode_ci. PK branch_id (AI).
model tbl_branches {
  branch_id       Int                      @id @default(autoincrement())
  branch_name     String?                  @db.VarChar(50)
  br_code         BrCode?
  from_id         Int // parent/region (0 = root)
  legacy_mappings legacy_branch_mappings[]

  @@map("tbl_branches")
}

/// Durable old-to-new branch ID mapping used by the branch-only legacy migration.
model legacy_branch_mappings {
  id            Int          @id @default(autoincrement())
  source_key    String       @db.VarChar(191)
  legacy_id     Int
  new_branch_id Int
  source_name   String?      @db.VarChar(50)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  branch        tbl_branches @relation(fields: [new_branch_id], references: [branch_id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([source_key, legacy_id], map: "uq_legacy_branch_source")
  @@index([new_branch_id], map: "idx_legacy_branch_target")
  @@map("legacy_branch_mappings")
}

/// LIVE branch geofence settings (parallel to tbl_branches). Engine=MyISAM, utf8mb3. PK id (AI).
model branch_settings {
  id       Int     @id @default(autoincrement())
  title    String  @db.VarChar(255)
  from_id  Int // parent
  lat_map  String? @db.VarChar(200)
  long_map String? @db.VarChar(200)
  distance Int     @default(100) @db.Int

  @@map("branch_settings")
}

/// Store-variant branch settings (near-duplicate). Engine=MyISAM, utf8mb3. PK id (AI).
model store_branch_settings {
  id       Int     @id @default(autoincrement())
  title    String  @db.VarChar(15)
  br_code  BrCode? // enum('A','B','C','')
  from_id  Int
  lat_map  String? @db.VarChar(15)
  long_map String? @db.VarChar(15)

  @@map("store_branch_settings")
}

/// Society/association locations. UNUSED by live employees (socity_branch_id_fk all NULL).
/// Engine=InnoDB, utf8mb3. PK id (AI).
model socity_branch {
  id       Int     @id @default(autoincrement())
  title    String  @db.VarChar(255)
  lat_map  String? @db.VarChar(100)
  long_map String? @db.VarChar(100)

  @@map("socity_branch")
}

// =====================================================================================
//  PROCUREMENT (gym-sales)
// =====================================================================================

model prc_quick_purchase_orders {
  id           Int       @id @default(autoincrement())
  order_number String    @unique @db.VarChar(40)
  supplier_id  Int
  product_id   Int
  product_name String    @db.VarChar(255)
  quantity     Decimal   @db.Decimal(14, 3)
  unit_price   Decimal   @db.Decimal(14, 2)
  total_amount Decimal   @db.Decimal(14, 2)
  warehouse_id Int
  branch_id    Int
  status       String    @default("مسودة") @db.VarChar(30)
  notes        String?   @db.Text
  stock_posted Boolean   @default(false)
  posted_at    DateTime?
  created_by   Int?
  is_deleted   Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([supplier_id])
  @@index([branch_id])
  @@index([status])
  @@map("prc_quick_purchase_orders")
}

model prc_purchase_returns {
  id            Int                         @id @default(autoincrement())
  return_number String                      @unique @db.VarChar(40)
  supplier_id   Int
  warehouse_id  Int
  branch_id     Int
  status        String                      @default("مسودة") @db.VarChar(30)
  total_amount  Decimal                     @default(0) @db.Decimal(14, 2)
  notes         String?                     @db.Text
  stock_posted  Boolean                     @default(false)
  posted_at     DateTime?
  created_by    Int?
  is_deleted    Boolean                     @default(false)
  created_at    DateTime                    @default(now())
  updated_at    DateTime                    @updatedAt
  items         prc_purchase_return_items[]

  @@index([supplier_id])
  @@index([branch_id])
  @@index([status])
  @@map("prc_purchase_returns")
}

model prc_purchase_return_items {
  id                 Int                  @id @default(autoincrement())
  purchase_return_id Int
  product_id         Int
  product_name       String               @db.VarChar(255)
  quantity           Decimal              @db.Decimal(14, 3)
  unit_price         Decimal              @default(0) @db.Decimal(14, 2)
  total              Decimal              @default(0) @db.Decimal(14, 2)
  purchase_return    prc_purchase_returns @relation(fields: [purchase_return_id], references: [id], onDelete: Cascade)

  @@index([purchase_return_id])
  @@map("prc_purchase_return_items")
}

model prc_procurement_settings {
  id                           Int      @id @default(autoincrement())
  branch_id                    Int?
  require_approval             Boolean  @default(true)
  approval_threshold           Decimal  @default(0) @db.Decimal(14, 2)
  max_order_amount             Decimal? @db.Decimal(14, 2)
  require_vendor_evaluation    Boolean  @default(false)
  min_quotations               Int      @default(1)
  enable_inventory_integration Boolean  @default(true)
  enable_three_way_match       Boolean  @default(true)
  match_tolerance_percent      Decimal  @default(0) @db.Decimal(6, 3)
  notify_email                 Boolean  @default(false)
  notify_sms                   Boolean  @default(false)
  notify_in_system             Boolean  @default(true)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  @@index([branch_id])
  @@map("prc_procurement_settings")
}

model prc_supplier_categories {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  description String?  @db.Text
  color       String?  @db.VarChar(20)
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([active])
  @@map("prc_supplier_categories")
}

model prc_supply_regions {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  description String?  @db.Text
  branches    Json?
  country     String?  @default("مصر") @db.VarChar(100)
  city        String?  @db.VarChar(100)
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([active])
  @@map("prc_supply_regions")
}

model prc_payment_terms {
  id                  Int      @id @default(autoincrement())
  name                String   @db.VarChar(150)
  description         String?  @db.Text
  days                Int      @default(0)
  type                String   @default("immediate") @db.VarChar(20)
  discount_percentage Decimal  @default(0) @db.Decimal(6, 3)
  active              Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([active])
  @@map("prc_payment_terms")
}

model prc_requisitions {
  id                    Int                     @id @default(autoincrement())
  request_number        String                  @unique @db.VarChar(40)
  request_type          String?                 @db.VarChar(40)
  requesting_department String                  @db.VarChar(150)
  required_date         String?                 @db.VarChar(10)
  priority              String                  @default("normal") @db.VarChar(20)
  status                String                  @default("draft") @db.VarChar(20)
  estimated_value       Decimal?                @db.Decimal(14, 2)
  approval_notes        String?                 @db.Text
  approved_by           Int?
  approved_at           DateTime?
  branch_id             Int
  created_by            Int?
  is_deleted            Boolean                 @default(false)
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  items                 prc_requisition_items[]
  purchase_orders       prc_purchase_orders[]

  @@index([branch_id])
  @@index([status])
  @@map("prc_requisitions")
}

model prc_requisition_items {
  id              Int              @id @default(autoincrement())
  requisition_id  Int
  product_id      Int?
  name            String           @db.VarChar(255)
  quantity        Decimal          @db.Decimal(14, 3)
  unit            String?          @db.VarChar(40)
  specifications  String?          @db.Text
  estimated_price Decimal?         @db.Decimal(14, 2)
  requisition     prc_requisitions @relation(fields: [requisition_id], references: [id], onDelete: Cascade)

  @@index([requisition_id])
  @@map("prc_requisition_items")
}

model prc_rfqs {
  id                    Int              @id @default(autoincrement())
  rfq_number            String           @unique @db.VarChar(40)
  subject               String           @db.VarChar(255)
  requesting_department String           @db.VarChar(150)
  required_date         String?          @db.VarChar(10)
  status                String           @default("draft") @db.VarChar(30)
  estimated_budget      Decimal?         @db.Decimal(14, 2)
  selected_vendor_id    Int?
  final_price           Decimal?         @db.Decimal(14, 2)
  branch_id             Int
  created_by            Int?
  is_deleted            Boolean          @default(false)
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  items                 prc_rfq_items[]
  quotations            prc_quotations[]

  @@index([branch_id])
  @@index([status])
  @@map("prc_rfqs")
}

model prc_rfq_items {
  id              Int      @id @default(autoincrement())
  rfq_id          Int
  product_id      Int?
  item_code       String?  @db.VarChar(60)
  item_name       String   @db.VarChar(255)
  quantity        Decimal  @db.Decimal(14, 3)
  unit            String?  @db.VarChar(40)
  estimated_price Decimal? @db.Decimal(14, 2)
  rfq             prc_rfqs @relation(fields: [rfq_id], references: [id], onDelete: Cascade)

