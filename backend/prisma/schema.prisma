/// Gym member. Old: Members.
model club_members {
  id                              Int                                  @id @default(autoincrement())
  member_code                     String                               @unique @db.VarChar(30)
  name                            String                               @db.VarChar(200)
  phone                           String?                              @db.VarChar(20)
  email                           String?                              @db.VarChar(150)
  gender                          ClubGender
  card_number                     String?                              @db.VarChar(30)
  date_of_birth                   String?                              @db.VarChar(10)
  address                         String?                              @db.Text
  marital_status                  String?                              @db.VarChar(20)
  job_title                       String?                              @db.VarChar(120)
  profile_picture                 String?                              @db.VarChar(255)
  membership_document_path        String?                              @db.VarChar(500)
  membership_document_uploaded_at DateTime?
  membership_document_uploaded_by Int?
  branch_id                       Int
  membership_type_id              Int?
  start_date                      String?                              @db.VarChar(10)
  end_date                        String?                              @db.VarChar(10)
  notes                           String?                              @db.Text
  is_active                       Boolean                              @default(true)
  is_blocked                      Boolean                              @default(false)
  block_reason                    String?                              @db.VarChar(500)
  blocked_at                      DateTime?
  blocked_by                      Int?
  sales_id                        Int?
  employee_id                     Int?
  guardian_name                   String?                              @db.VarChar(200)
  guardian_phone                  String?                              @db.VarChar(20)
  app_user_id                     Int?
  is_deleted                      Boolean                              @default(false)
  created_by                      Int?
  created_at                      DateTime                             @default(now())
  updated_at                      DateTime                             @updatedAt
  membership_type                 club_membership_types?               @relation(fields: [membership_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendances                     club_attendance[]
  subscriptions                   club_subscriptions[]
  receipts                        club_receipts[]
  refunds                         club_subscription_refunds[]
  transfers                       club_subscription_transfers[]
  member_transfers_out            club_member_subscription_transfers[] @relation("member_transfer_source_member")
  member_transfers_in             club_member_subscription_transfers[] @relation("member_transfer_destination_member")
  locker_subs                     club_locker_subscriptions[]
  event_registrations             club_event_registrations[]
  group_membership                club_member_group_members?
  community_posts                 community_posts[]
  community_reactions             community_reactions[]
  discount_codes                  club_discount_code_members[]
  trainer_ratings                 club_trainer_ratings[]
  documents                       club_member_documents[]

  @@unique([branch_id, phone], map: "uq_club_member_branch_phone")
  @@index([branch_id])
  @@index([membership_type_id])
  @@index([card_number])
  @@index([name])
  @@index([phone])
  @@index([app_user_id])
  @@index([created_by])
  @@index([is_blocked])
  @@index([branch_id, is_active, is_deleted])
  @@index([branch_id, is_deleted, created_at], map: "idx_club_members_dashboard")
  @@map("club_members")
}

/// Auditable member documents. The old singular PDF columns remain untouched for
/// backwards compatibility; each upload here is a separately named record.
model club_member_documents {
  id                Int          @id @default(autoincrement())
  member_id         Int
  document_type     String       @db.VarChar(40)
  label             String?      @db.VarChar(160)
  storage_path      String       @db.VarChar(500)
  original_filename String       @db.VarChar(255)
  mime_type         String       @db.VarChar(100)
  byte_size         Int
  sha256            String?      @db.VarChar(64)
  uploaded_by       Int?
  uploaded_at       DateTime     @default(now())
  member            club_members @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([member_id, uploaded_at])
  @@index([member_id, document_type])
  @@index([uploaded_by])
  @@map("club_member_documents")
}

model club_leads {
  id                  Int                    @id @default(autoincrement())
  full_name           String                 @db.VarChar(200)
  phone               String                 @db.VarChar(50)
  source              String                 @db.VarChar(40)
  status              String                 @default("new") @db.VarChar(20)
  assigned_to_id      Int?
  converted_member_id Int?
  notes               String?                @db.Text
  last_contacted_at   DateTime?
  next_follow_up_at   DateTime?
  next_call_at        DateTime?
  branch_id           Int
  created_by          Int?
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt
  follow_ups          club_lead_follow_ups[]

  @@index([assigned_to_id, branch_id])
  @@index([converted_member_id])
  @@index([status])
  @@map("club_leads")
}

model club_lead_follow_ups {
  id                Int        @id @default(autoincrement())
  lead_id           Int
  note              String     @db.Text
  status            String?    @db.VarChar(20)
  activity_type     String     @default("note") @db.VarChar(20)
  answered          Boolean?
  interests         String?    @db.Text
  next_follow_up_at DateTime?
  next_call_at      DateTime?
  created_by        Int?
  created_at        DateTime   @default(now())
  lead              club_leads @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id])
  @@map("club_lead_follow_ups")
}

/// Member attendance / check-in. Old: MemberAttendances.
model club_attendance {
  id                 Int                                  @id @default(autoincrement())
  member_id          Int
  member_code        String                               @db.VarChar(30)
  member_name        String                               @db.VarChar(200)
  subscription_id    Int?
  subscription_type  String?                              @db.VarChar(150)
  branch_id          Int
  check_in_time      DateTime                             @default(now())
  check_out_time     DateTime?
  attendance_date    String                               @db.VarChar(10)
  status             ClubAttendanceStatus                 @default(checked_in)
  duration           Int?
  notes              String?                              @db.Text
  /// Entry allowed by staff despite a blocking entitlement (expired subscription, dues, …).
  is_grace_session   Boolean                              @default(false)
  /// Why the block was bypassed — mirrors the reason stored on business_audit_log.
  override_reason    String?                              @db.VarChar(255)
  created_by         Int?
  created_at         DateTime                             @default(now())
  member             club_members                         @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  private_commission club_private_attendance_commissions?
  trainer_rating     club_trainer_ratings?

  @@index([member_id])
  @@index([branch_id])
  @@index([attendance_date])
  @@index([status])
  @@index([member_code])
  @@index([attendance_date, check_in_time])
  @@index([subscription_id])
  @@index([is_grace_session, attendance_date])
  @@index([branch_id, attendance_date], map: "idx_club_attendance_dashboard")
  @@map("club_attendance")
}

model club_subscription_types {
  id                           Int                                     @id @default(autoincrement())
  name                         String                                  @db.VarChar(150)
  branch_id                    Int?
  apply_to_all_branches        Boolean                                 @default(false)
  price                        Decimal                                 @db.Decimal(10, 2)
  days                         Int
  is_part_of_target            Boolean                                 @default(false)
  invitations_count            Int?
  inbody_count                 Int?
  is_special_offer             Boolean                                 @default(false)
  is_for_students              Boolean                                 @default(false)
  show_in_app                  Boolean                                 @default(false)
  notify_customers             Boolean                                 @default(false)
  notify_on_expiry             Boolean                                 @default(false)
  wallet_points                Int?
  offer_validity               String?                                 @db.VarChar(10)
  is_linked_to_sessions        Boolean                                 @default(false)
  sessions_count               Int?
  allow_multiple_daily_entries Boolean                                 @default(false)
  is_linked_to_freeze          Boolean                                 @default(false)
  /// Max number of times this package may be frozen (historical column name: freeze_days).
  freeze_days                  Int?
  includes_spa                 Boolean                                 @default(false)
  spa_count                    Int?
  is_active                    Boolean                                 @default(true)
  created_at                   DateTime                                @default(now())
  updated_at                   DateTime                                @updatedAt
  subscriptions                club_subscriptions[]
  branches                     club_subscription_type_branches[]
  class_types                  club_subscription_type_classes[]
  session_prices               club_subscription_type_session_prices[]
  branch_prices                club_subscription_type_branch_prices[]

  @@map("club_subscription_types")
}

/// Per-session-count prices for session packages (1..N). Overrides default price/N × k.
model club_subscription_type_session_prices {
  id                   Int                     @id @default(autoincrement())
  subscription_type_id Int
  sessions_count       Int
  price                Decimal                 @db.Decimal(10, 2)
  type                 club_subscription_types @relation(fields: [subscription_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([subscription_type_id, sessions_count], map: "uq_sub_type_session_price")
  @@index([subscription_type_id])
  @@map("club_subscription_type_session_prices")
}

/// Per-branch price override. The package base price remains the safe fallback.
model club_subscription_type_branch_prices {
  id                   Int                     @id @default(autoincrement())
  subscription_type_id Int
  branch_id            Int
  price                Decimal                 @db.Decimal(10, 2)
  type                 club_subscription_types @relation(fields: [subscription_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([subscription_type_id, branch_id], map: "uq_sub_type_branch_price")
  @@index([branch_id])
  @@map("club_subscription_type_branch_prices")
}

/// Publicly displayed online transfer destinations. `account_secret` is deliberately never
/// returned by the public API; it is reserved for permitted portal administrators.
model online_payment_methods {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(120)
  method_type      String   @db.VarChar(40)
  destination_name String?  @db.VarChar(180)
  account_display  String?  @db.VarChar(255)
  account_secret   String?  @db.Text
  branch_id        Int?
  is_active        Boolean  @default(true)
  display_order    Int      @default(1)
  created_by       Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([is_active, display_order])
  @@index([branch_id])
  @@map("online_payment_methods")
}

/// Staged public membership checkout. Price/package/payment data are immutable snapshots, and a
/// unique promotion link makes approval/retry idempotent without exposing a proof file publicly.
enum OnlineSubscriptionRequestStatus {
  draft
  submitted
  approved
  rejected
}

model online_subscription_requests {
  id                                    Int                             @id @default(autoincrement())
  status                                OnlineSubscriptionRequestStatus @default(draft)
  package_id                            Int
  package_name_snapshot                 String                          @db.VarChar(150)
  package_days_snapshot                 Int
  branch_id                             Int
  price_snapshot                        Decimal                         @db.Decimal(10, 2)
  payment_method_id                     Int
  payment_name_snapshot                 String                          @db.VarChar(120)
  payment_destination_snapshot          String?                         @db.VarChar(180)
  payment_account_snapshot              String?                         @db.VarChar(255)
  is_linked_to_sessions_snapshot        Boolean                         @default(false)
  sessions_count_snapshot               Int?
  allow_multiple_daily_entries_snapshot Boolean                         @default(false)
  applicant_name                        String                          @db.VarChar(200)
  applicant_phone                       String                          @db.VarChar(30)
  applicant_email                       String?                         @db.VarChar(200)
  applicant_gender                      ClubGender?
  proof_path                            String?                         @db.VarChar(120)
  proof_mime                            String?                         @db.VarChar(100)
  proof_size                            Int?
  rejection_reason                      String?                         @db.Text
  reviewed_by                           Int?
  reviewed_at                           DateTime?
  promoted_subscription_id              Int?                            @unique(map: "uq_online_request_promoted_subscription")
  submitted_at                          DateTime?
  created_at                            DateTime                        @default(now())
  updated_at                            DateTime                        @updatedAt

  @@index([status, branch_id, created_at], map: "idx_online_request_queue")
  @@index([applicant_phone, branch_id], map: "idx_online_request_phone_branch")
  @@map("online_subscription_requests")
}

/// Reusable percentage discount codes. Each purchase also stores the applied percentage and
/// amount as a snapshot, so later code edits never rewrite financial history.
model club_discount_codes {
  id                   Int                          @id @default(autoincrement())
  code                 String                       @unique @db.VarChar(80)
  percentage           Decimal                      @db.Decimal(6, 3)
  is_active            Boolean                      @default(true)
  max_uses             Int?
  valid_from           String?                      @db.VarChar(10)
  valid_to             String?                      @db.VarChar(10)
  audience             String                       @default("all_users") @db.VarChar(30)
  created_by           Int?
  created_at           DateTime                     @default(now())
  updated_at           DateTime                     @updatedAt
  subscriptions        club_subscriptions[]
  locker_subscriptions club_locker_subscriptions[]
  members              club_discount_code_members[]

  @@index([is_active])
  @@map("club_discount_codes")
}

model club_discount_code_members {
  id               Int                 @id @default(autoincrement())
  discount_code_id Int
  member_id        Int
  discount_code    club_discount_codes @relation(fields: [discount_code_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  member           club_members        @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([discount_code_id, member_id])
  @@index([member_id])
  @@map("club_discount_code_members")
}

model club_subscription_type_branches {
  id                   Int                     @id @default(autoincrement())
  subscription_type_id Int
  branch_id            Int
  type                 club_subscription_types @relation(fields: [subscription_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([subscription_type_id, branch_id], map: "uq_sub_type_branch")
  @@index([branch_id])
  @@map("club_subscription_type_branches")
}

/// Singleton gym access policies (row id = 1).
model club_gym_policies {
  id                                       Int      @id @default(1)
  allow_checkin_with_outstanding           Boolean  @default(true)
  outstanding_alert_enabled                Boolean  @default(true)
  outstanding_alert_after_subscription_pct Int      @default(50)
  allow_refunds                            Boolean  @default(true)
  allow_staff_view_all_cashiers            Boolean  @default(false)
  print_subscription_receipts              Boolean  @default(false)
  print_subscription_payments              Boolean  @default(false)
  print_quick_service_receipts             Boolean  @default(false)
  receipt_paper_size                       String   @default("thermal") @db.VarChar(10)
  receipt_a4_copies                        Int      @default(2) @db.UnsignedTinyInt
  receipt_language                         String   @default("ar") @db.VarChar(2)
  updated_at                               DateTime @updatedAt
  updated_by                               Int?

  @@map("club_gym_policies")
}

model club_subscriptions {
  id                             Int                                   @id @default(autoincrement())
  renewed_from_subscription_id   Int?                                  @unique
  subscription_number            String                                @unique @db.VarChar(30)
  registration_date              String                                @db.VarChar(10)
  branch_id                      Int
  member_id                      Int?
  customer_name                  String?                               @db.VarChar(200)
  subscription_type_id           Int?
  special_class_type_id          Int?
  private_package_id             Int?
  private_trainer_id             Int?
  private_discount_type          String?                               @db.VarChar(80)
  subscription_type              String?                               @db.VarChar(150)
  subscription_start_date        String                                @db.VarChar(10)
  subscription_end_date          String                                @db.VarChar(10)
  subscription_value             Decimal                               @db.Decimal(10, 2)
  discount_enabled               Boolean                               @default(false)
  discount_code_id               Int?
  discount_percentage            Decimal?                              @db.Decimal(6, 3)
  discount_value                 Decimal                               @default(0) @db.Decimal(10, 2)
  paid_amount                    Decimal                               @default(0) @db.Decimal(10, 2)
  waived_amount                  Decimal                               @default(0) @db.Decimal(10, 2)
  /// Non-cash value received from another member's subscription. It settles this contract
  /// without being reported as a receipt, treasury movement, or new revenue.
  transferred_credit_amount      Decimal                               @default(0) @db.Decimal(10, 2)
  /// Informational value moved out of this subscription; original receipts remain immutable.
  transferred_out_amount         Decimal                               @default(0) @db.Decimal(10, 2)
  remaining_amount               Decimal                               @default(0) @db.Decimal(10, 2)
  gender                         ClubGender?
  employee_id                    Int?
  sales_id                       Int?
  payment_method                 ClubPaymentMethod?
  receipt_number                 String?                               @db.VarChar(30)
  customer_source_id             Int?
  guardian_name                  String?                               @db.VarChar(200)
  guardian_phone                 String?                               @db.VarChar(20)
  status                         ClubSubStatus                         @default(active)
  is_special                     Boolean                               @default(false)
  is_linked_to_sessions          Boolean                               @default(false)
  sessions_count                 Int?
  sessions_used                  Int                                   @default(0)
  /// Number of included InBody sessions already consumed from this subscription.
  inbody_used                    Int                                   @default(0)
  /// Number of included SPA sessions already consumed from this subscription.
  spa_used                       Int                                   @default(0)
  allow_multiple_daily_entries   Boolean                               @default(false)
  is_time_based                  Boolean                               @default(false)
  time_from                      String?                               @db.VarChar(8)
  time_to                        String?                               @db.VarChar(8)
  created_by                     Int?
  created_at                     DateTime                              @default(now())
  updated_at                     DateTime                              @updatedAt
  member                         club_members?                         @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type                           club_subscription_types?              @relation(fields: [subscription_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  special_class_type             club_class_types?                     @relation(fields: [special_class_type_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  discount_code                  club_discount_codes?                  @relation(fields: [discount_code_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  private_package                club_private_packages?                @relation(fields: [private_package_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  private_trainer                club_trainers?                        @relation(fields: [private_trainer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  private_attendance_commissions club_private_attendance_commissions[]
  receipts                       club_receipts[]
  refunds                        club_subscription_refunds[]
  plan_transfers_out             club_subscription_transfers[]         @relation("plan_transfer_source_subscription")
  plan_transfers_in              club_subscription_transfers[]         @relation("plan_transfer_destination_subscription")
  member_transfer_source         club_member_subscription_transfers?   @relation("member_transfer_source_subscription")
  member_transfer_destination    club_member_subscription_transfers?   @relation("member_transfer_destination_subscription")
  freezes                        club_subscription_freezes[]
  waivers                        club_subscription_waivers[]
  inbody_invoices                club_inbody_invoices[]
  spa_invoices                   club_spa_invoices[]
  renewed_from                   club_subscriptions?                   @relation("club_subscription_renewal_chain", fields: [renewed_from_subscription_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  renewal_successor              club_subscriptions?                   @relation("club_subscription_renewal_chain")

  @@index([member_id])
  @@index([special_class_type_id])
  @@index([private_package_id])
  @@index([private_trainer_id])
  @@index([discount_code_id])
  @@index([branch_id])
  @@index([status])
  @@index([branch_id, registration_date], map: "idx_club_subscriptions_dashboard_registration")
  @@index([branch_id, subscription_start_date, subscription_end_date], map: "idx_club_subscriptions_dashboard_period")
  @@map("club_subscriptions")
}

model club_private_packages {
  id                          Int                             @id @default(autoincrement())
  kind                        ClubPrivatePackageKind
  name                        String                          @db.VarChar(150)
  price                       Decimal                         @db.Decimal(10, 2)
  duration_days               Int
  sessions_count              Int?
  is_active                   Boolean                         @default(true)
  created_by                  Int?
  legacy_subscription_type_id Int?                            @unique(map: "uq_private_packages_legacy_subscription_type")
  created_at                  DateTime                        @default(now())
  updated_at                  DateTime                        @updatedAt
  branches                    club_private_package_branches[]
  subscriptions               club_subscriptions[]

  @@index([kind, is_active])
  @@map("club_private_packages")
}

model club_private_package_branches {
  package_id Int
  branch_id  Int
  created_at DateTime              @default(now())
  package    club_private_packages @relation(fields: [package_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([package_id, branch_id])
  @@index([branch_id])
  @@map("club_private_package_branches")
}

/// Immutable earning snapshot produced by a private check-in.
model club_private_attendance_commissions {
  id                    Int                @id @default(autoincrement())
  attendance_id         Int                @unique
  subscription_id       Int
  trainer_id            Int
  commission_sequence   Int
  attendance_date       String             @db.VarChar(10)
  revenue_base          Decimal            @db.Decimal(10, 2)
  commission_percentage Decimal            @db.Decimal(5, 2)
  commission_amount     Decimal            @db.Decimal(10, 2)
  created_at            DateTime           @default(now())
  attendance            club_attendance    @relation(fields: [attendance_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscription          club_subscriptions @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trainer               club_trainers      @relation(fields: [trainer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([subscription_id, commission_sequence], map: "uq_private_sub_commission_sequence")
  @@index([trainer_id, attendance_date])
  @@map("club_private_attendance_commissions")
}

/// A debt release is not a payment and never posts to treasury or the general ledger.
model club_subscription_waivers {
  id              Int                @id @default(autoincrement())
  subscription_id Int
  member_id       Int?
  member_name     String?            @db.VarChar(200)
  amount          Decimal            @db.Decimal(10, 2)
  waiver_date     String             @db.VarChar(10)
  reason          String?            @db.VarChar(500)
  created_by      Int?
  created_at      DateTime           @default(now())
  subscription    club_subscriptions @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([subscription_id])
  @@index([member_id])
  @@index([waiver_date])
  @@map("club_subscription_waivers")
}

model club_receipts {
  id                     Int                        @id @default(autoincrement())
  receipt_number         String                     @unique @db.VarChar(30)
  subscription_id        Int?
  locker_subscription_id Int?
  member_id              Int?
  member_name            String                     @db.VarChar(200)
  /// Branch the money was collected at. Required for walk-in receipts, which have neither a
  /// subscription nor a member to derive it from; branch-scoped reports read this first.
  branch_id              Int?
  amount                 Decimal                    @db.Decimal(10, 2)
  type                   String?                    @db.VarChar(50)
  /// Dominant method only (biggest slice). The authoritative breakdown is `payments`.
  payment_method         ClubPaymentMethod?
  receipt_date           String                     @db.VarChar(10)
  status                 String                     @default("مدفوعة") @db.VarChar(30)
  description            String?                    @db.Text
  created_by             Int?
  created_at             DateTime                   @default(now())
  updated_at             DateTime                   @updatedAt
  subscription           club_subscriptions?        @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locker_subscription    club_locker_subscriptions? @relation(fields: [locker_subscription_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  member                 club_members?              @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments               club_receipt_payments[]

  @@index([subscription_id])
  @@index([locker_subscription_id])
  @@index([member_id])
  @@index([branch_id])
  @@index([created_by, receipt_date])
  @@map("club_receipts")
}

/// Split tender for one receipt — a single collection may mix methods (300 cash + 200 transfer).
/// Written for every receipt, including single-method ones, so treasury, reports and the GL read
/// one uniform breakdown instead of falling back to `club_receipts.payment_method`.
/// Invariant: SUM(amount) per receipt == club_receipts.amount.
model club_receipt_payments {
  id         Int               @id @default(autoincrement())
  receipt_id Int
