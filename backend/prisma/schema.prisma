/// A non-cash transfer of the unconsumed entitlement from one member to another.
/// source_subscription_id is unique: one source entitlement can never be transferred twice.
model club_member_subscription_transfers {
  id                          Int                @id @default(autoincrement())
  source_subscription_id      Int                @unique(map: "uq_member_transfer_source_sub")
  destination_subscription_id Int                @unique(map: "uq_member_transfer_destination_sub")
  source_member_id            Int
  destination_member_id       Int
  source_branch_id            Int
  destination_branch_id       Int
  entitlement_kind            String             @db.VarChar(20)
  remaining_days              Int?
  remaining_sessions          Int?
  transferred_value           Decimal            @db.Decimal(10, 2)
  effective_date              String             @db.VarChar(10)
  reason                      String             @db.Text
  created_by                  Int
  before_json                 Json
  after_json                  Json
  created_at                  DateTime           @default(now())
  source_subscription         club_subscriptions @relation("member_transfer_source_subscription", fields: [source_subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_member_transfer_source_sub")
  destination_subscription    club_subscriptions @relation("member_transfer_destination_subscription", fields: [destination_subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_member_transfer_destination_sub")
  source_member               club_members       @relation("member_transfer_source_member", fields: [source_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_member_transfer_source_member")
  destination_member          club_members       @relation("member_transfer_destination_member", fields: [destination_member_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_member_transfer_destination_member")

  @@index([source_member_id, created_at], map: "idx_member_transfer_source_member")
  @@index([destination_member_id, created_at], map: "idx_member_transfer_destination_member")
  @@index([source_branch_id, created_at], map: "idx_member_transfer_source_branch")
  @@index([destination_branch_id, created_at], map: "idx_member_transfer_destination_branch")
  @@map("club_member_subscription_transfers")
}

