  event_id            Int
  session_id          Int?
  tier_id             Int?
  registrant_type     ClubEventRegistrantType  @default(member)
  member_id           Int?
  guest_name          String?                  @db.VarChar(200)
  guest_phone         String?                  @db.VarChar(20)
  guest_email         String?                  @db.VarChar(150)
  lead_source         String?                  @db.VarChar(100)
  converted_member_id Int?
  branch_id           Int
  status              ClubEventRegStatus       @default(pending_payment)
  waitlist_position   Int?
  hold_expires_at     DateTime?
  price               Decimal                  @default(0) @db.Decimal(10, 2)
  discount_value      Decimal                  @default(0) @db.Decimal(10, 2)
  paid_amount         Decimal                  @default(0) @db.Decimal(10, 2)
  checkin_code        String                   @unique @db.VarChar(40)
  participant_dob     String?                  @db.VarChar(10)
  guardian_name       String?                  @db.VarChar(200)
  guardian_phone      String?                  @db.VarChar(20)
  guardian_relation   String?                  @db.VarChar(50)
  consent_signed      Boolean                  @default(false)
