{
  "name": "one80-hr-backend",
  "version": "0.1.0",
  "description": "ONE80 Gym & Fitness Hub — HR backend (NestJS + Prisma)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:history:doctor": "tsx prisma/scripts/migration-history-doctor.ts",
    "prisma:history:repair": "tsx prisma/scripts/migration-history-doctor.ts --apply",
    "prisma:rehearse": "tsx prisma/scripts/migration-rehearsal.ts",
    "prisma:push": "node prisma/scripts/guarded-db-push.mjs",
    "prisma:drift:check": "node prisma/scripts/check-schema-drift.mjs",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:reference": "ts-node prisma/seed/05-reference-catalogs.ts",
    "db:seed:rbac": "ts-node prisma/seed-rbac.ts",
    "db:reseed": "node prisma/scripts/guarded-db-push.mjs --reseed",
    "db:import:customers": "ts-node -r tsconfig-paths/register prisma/scripts/import-customers.ts",
    "db:import:requested-trainers": "ts-node -r tsconfig-paths/register prisma/scripts/import-requested-trainer-employees.ts",
    "db:provision:member-app-accounts": "ts-node -r tsconfig-paths/register prisma/scripts/provision-member-app-accounts.ts",
    "db:reset:member-passwords": "ts-node -r tsconfig-paths/register prisma/scripts/reset-member-passwords.ts",
    "db:clear:hr-demo": "ts-node prisma/scripts/clear-hr-demo-data.ts",
    "db:prepare:production": "ts-node prisma/scripts/clear-hr-demo-data.ts",
    "db:clear:finance-demo": "ts-node prisma/scripts/clear-finance-demo-data.ts",
    "db:clear:fitness-cafe-demo": "ts-node prisma/scripts/clear-fake-fitness-cafe-data.ts",
    "db:reset:cafe": "ts-node prisma/scripts/reset-cafe-production.ts",
    "db:repair:cafe-accounting": "ts-node prisma/scripts/repair-orphan-cafe-accounting.ts",
    "db:purge:test-members": "ts-node prisma/scripts/purge-initial-test-members.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "lint": "npm run typecheck",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "axios": "^1.20.0",
    "jest": "^30.4.2",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
