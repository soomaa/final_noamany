{
  "name": "one80-hr-backend",
  "version": "0.1.0",
  "description": "Noamany Fitness Center — management backend (NestJS + Prisma)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "build:unified": "npm --prefix ../frontend run build && npm --prefix ../website-redesign run build && node scripts/assemble-unified-public.js && npm run build",
    "start": "nest start",
    "prestart:dev": "node scripts/clean-dev-dist.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:preflight": "node scripts/migration-preflight.mjs",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "docs:api:build": "node scripts/build-new-api-documentation.js",
    "docs:api:test": "node scripts/test-build-new-api-documentation.js",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:reference": "ts-node prisma/seed/05-reference-catalogs.ts",
    "db:seed:rbac": "ts-node prisma/seed-rbac.ts",
    "db:reseed": "prisma db push --force-reset --accept-data-loss && ts-node prisma/seed.ts",
    "db:import:customers": "ts-node -r tsconfig-paths/register prisma/scripts/import-customers.ts",
    "db:import:legacy-portal": "ts-node prisma/scripts/import-legacy-portal.ts",
    "db:migrate:branches": "ts-node prisma/scripts/migrate-branches.ts",
    "db:validate:branches": "ts-node prisma/scripts/validate-branches.ts",
    "db:repair:noamany-club-branches": "ts-node prisma/scripts/repair-noamany-club-branches.ts",
    "db:validate:noamany-club-branches": "ts-node prisma/scripts/repair-noamany-club-branches.ts --dry-run",
    "db:migrate:employees": "ts-node prisma/scripts/migrate-employees.ts",
    "db:validate:employees": "ts-node prisma/scripts/validate-employees.ts",
    "db:migrate:users": "ts-node prisma/scripts/migrate-users.ts",
    "db:validate:users": "ts-node prisma/scripts/validate-users.ts",
    "db:migrate:legacy-core": "ts-node prisma/scripts/migrate-legacy-core.ts",
    "db:migrate:legacy-commerce": "ts-node prisma/scripts/migrate-legacy-commerce.ts",
    "db:migrate:legacy-shared": "ts-node prisma/scripts/migrate-legacy-shared-tables.ts",
    "db:migrate:legacy-secondary": "ts-node prisma/scripts/migrate-legacy-secondary.ts",
    "db:migrate:legacy-gaps": "ts-node prisma/scripts/migrate-legacy-gaps.ts",
    "db:cleanup:legacy-hr-import": "ts-node prisma/scripts/cleanup-legacy-hr-import.ts",
    "db:verify:legacy-hr-gaps": "ts-node prisma/scripts/verify-hr-legacy-gaps.ts",
    "db:audit:hr-schema": "ts-node prisma/scripts/audit-hr-schema.ts",
    "db:rebuild:legacy-finance": "ts-node prisma/scripts/rebuild-legacy-financial-ledger.ts",
    "db:validate:legacy-full": "ts-node prisma/scripts/validate-legacy-full-import.ts",
    "db:replace:org-legacy": "tsx prisma/scripts/replace-org-with-legacy-data.ts",
    "db:replace:action-screen-legacy": "tsx prisma/scripts/replace-action-screen-with-legacy-data.ts",
    "db:clear:hr-demo": "ts-node prisma/scripts/clear-hr-demo-data.ts",
    "db:prepare:production": "ts-node prisma/scripts/clear-hr-demo-data.ts",
    "db:clear:finance-demo": "ts-node prisma/scripts/clear-finance-demo-data.ts",
    "db:clear:fitness-cafe-demo": "ts-node prisma/scripts/clear-fake-fitness-cafe-data.ts",
    "db:clear:payroll-demo": "ts-node prisma/scripts/clear-payroll-demo-data.ts",
    "db:clear:seed-demo": "ts-node prisma/scripts/clear-seed-demo-data.ts",
    "db:reset:cafe": "ts-node prisma/scripts/reset-cafe-production.ts",
    "db:repair:cafe-accounting": "ts-node prisma/scripts/repair-orphan-cafe-accounting.ts",
    "db:purge:test-members": "ts-node prisma/scripts/purge-initial-test-members.ts",
    "test": "jest",
    "test:mobile-api": "node scripts/test-mobile-api-all.js",
    "test:mobile-api:modern": "node scripts/test-mobile-api-all.js --modern-only",
    "test:watch": "jest --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^30.4.2",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
