# Noamany backend — LOCAL DEVELOPMENT template.
# Copy to .env and replace all placeholder credentials/secrets locally.

# MySQL database created by ../restore-ready-data.sh
DATABASE_URL="mysql://root:MYSQL_PASSWORD@localhost:3306/noamany_app"

# App
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS (the React dev server)
CORS_ORIGINS="http://localhost:5173"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="2h"
JWT_REFRESH_TTL="7d"
# bcrypt cost for rehashing legacy sha1(md5) passwords on login
BCRYPT_ROUNDS=12

# File uploads
UPLOAD_DIR="./uploads"
PUBLIC_UPLOAD_BASE="/uploads"
# Sensitive member PDFs must stay outside UPLOAD_DIR (which is publicly mounted).
PRIVATE_MEMBER_DOCUMENT_DIR="./private-member-documents"
# Payment proofs must also stay outside the publicly mounted UPLOAD_DIR.
PRIVATE_ONLINE_PROOF_DIR="./private-online-proofs"

# Redis (optional — enables BullMQ background jobs for webhooks, automation, etc.)
# REDIS_URL="redis://localhost:6379"

# Payroll business rules (optional — defaults match the previous hardcoded values).
# PAYROLL_WORKING_DAYS=30
# PAYROLL_HOURS_PER_DAY=8
# PAYROLL_DEFAULT_OFF_DAY="Friday"
# Employee codes exempt from absence/lateness deductions (comma-separated).
# PAYROLL_DEDUCTION_EXEMPT_EMP_CODES="27,2,3,58,29,39"
