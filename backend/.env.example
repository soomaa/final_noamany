# Noamany backend — LOCAL DEVELOPMENT template.
# Copy to .env and replace all placeholder credentials/secrets locally.

# MySQL database created by ../restore-ready-data.sh
DATABASE_URL="mysql://root:MYSQL_PASSWORD@localhost:3306/noamany_app"

# App
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
# Set true when running a local copy of server data to keep scheduled tasks off.
DISABLE_SCHEDULED_TASKS=false
# Comma-separated allowed origins for CORS (the React dev server)
CORS_ORIGINS="http://localhost:5173"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="2h"
JWT_REFRESH_TTL="7d"
# bcrypt cost for rehashing legacy sha1(md5) passwords on login
BCRYPT_ROUNDS=12

# File uploads
UPLOAD_DIR="./uploads"
PUBLIC_UPLOAD_BASE="/uploads"

# Redis (optional — enables BullMQ background jobs for webhooks, automation, etc.)
# REDIS_URL="redis://localhost:6379"

# Payroll business rules (optional — defaults match the previous hardcoded values).
# PAYROLL_WORKING_DAYS=30
# PAYROLL_HOURS_PER_DAY=8
# PAYROLL_DEFAULT_OFF_DAY="Friday"
# Employee codes exempt from absence/lateness deductions (comma-separated).
# PAYROLL_DEDUCTION_EXEMPT_EMP_CODES="27,2,3,58,29,39"

# WhatsApp sending limits from Gymora SaaS (super-admin «واتساب» → client «Noamany» → API key).
# Both set: every message asks Gymora for a permit (daily/monthly limits, hours, kill switch).
# Both empty: the local allowance row (wa_clients) is used. Restart the backend after changing.
WA_CONTROL_URL=
WA_CONTROL_KEY=

# On-site fingerprint agent (tools/zk-agent). Shared secret the agent sends as X-Agent-Token
# to POST /attendance/device-agent/punches. Leave empty to keep device push disabled.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATTENDANCE_AGENT_TOKEN=""
