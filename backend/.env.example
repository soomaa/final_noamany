# ONE80 HR backend — environment template
# Copy to .env and fill real values.

# MySQL (the rebuilt schema; migrate legacy data from noamanycenter_hr.sql)
DATABASE_URL="mysql://root:root@localhost:3306/one80_hr"
PRIVATE_UPLOAD_DIR="./private-uploads"

# App
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS (the React dev server)
CORS_ORIGINS="http://localhost:5173"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="2h"
JWT_REFRESH_TTL="7d"
# bcrypt cost for rehashing legacy sha1(md5) passwords on login
BCRYPT_ROUNDS=12

# File uploads
UPLOAD_DIR="./uploads"
PUBLIC_UPLOAD_BASE="/uploads"

# Attendance devices: explicit IP CIDRs only. Empty disables all outbound device access.
# Loopback, link-local/metadata, multicast, and hostnames are always rejected.
# ATTENDANCE_DEVICE_ALLOWED_CIDRS="10.20.0.0/16,192.168.40.25/32"

# Redis (optional — enables BullMQ background jobs for webhooks, automation, etc.)
# REDIS_URL="redis://localhost:6379"

# Prometheus endpoint (/api/metrics). Disabled until a strong bearer token is configured.
# METRICS_BEARER_TOKEN="generate-a-long-random-secret"

# Payroll business rules (optional — defaults match the previous hardcoded values).
# PAYROLL_WORKING_DAYS=30
# PAYROLL_HOURS_PER_DAY=8
# PAYROLL_DEFAULT_OFF_DAY="Friday"
# Employee codes exempt from absence/lateness deductions (comma-separated).
# PAYROLL_DEDUCTION_EXEMPT_EMP_CODES="27,2,3,58,29,39"

# Dashboard virtual branches: "virtualId=phys,phys;..." (e.g. branch 3 aggregates 6,7,3).
# DASHBOARD_BRANCH_FANOUT="3=6,7,3"
