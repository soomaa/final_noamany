{
  "name": "one80-hr-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:modal-runtime && tsc -b && vite build",
    "test": "tsx --test \"src/**/*.spec.ts\"",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "npm run typecheck",
    "i18n:wrap": "node scripts/wrap-remaining-ui.mjs",
    "i18n:map": "node scripts/rebuild-ui-map.mjs && node scripts/sync-ui-map-translations.mjs",
    "test:modal-runtime": "node --test scripts/check-radix-modal-runtime.test.mjs",
    "test:cafe-port": "node --experimental-strip-types --test src/components/cafe/pos-product-browser-frame.test.mjs src/components/cafe/product-variants-recipe-dialog.test.mjs src/lib/touch-keypad.spec.ts src/lib/employee-benefits.spec.ts src/lib/saved-pos-receipt.spec.ts src/lib/receipt-brand.spec.ts src/pages/sales/invoice-print-access.spec.ts scripts/check-employee-invoice-print.test.mjs src/lib/shift-close-print.spec.ts src/pages/cafe-dashboard/dashboard-model.test.ts src/lib/completed-invoice-edit.spec.ts src/lib/invoice-editor-access.spec.ts src/lib/cafe-invoice-classification.spec.ts test/cafe-invoice-category.test.cjs",
    "build:body3d": "node scripts/body3d/build-viewer.mjs",
    "test:training": "tsx --test src/pages/club/fitness/training/*.spec.ts && node --test src/components/training/body3d/fitter.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/tajawal": "^5.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-direction": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slider": "^1.4.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-table": "^8.21.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "three": "0.180.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@radix-ui/react-focus-scope": "1.1.11",
    "@radix-ui/react-dismissable-layer": "1.1.13"
  }
}
