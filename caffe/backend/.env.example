# Ordera cafe backend — environment template
# Copy to .env and fill real values.

# MySQL — dedicated Ordera database (do NOT reuse one80_hr)
DATABASE_URL="mysql://root:root@localhost:3306/ordera_cafe"

# App (ports chosen to not clash with main gym app on 4000/5173)
PORT=4100
NODE_ENV=development
CORS_ORIGINS="http://localhost:5174"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="2h"
JWT_REFRESH_TTL="7d"
BCRYPT_ROUNDS=12

# File uploads
UPLOAD_DIR="./uploads"
PUBLIC_UPLOAD_BASE="/uploads"

# Optional: clear cafe demo products after seed
# ORDERA_CLEAR_CAFE_DEMO=1
